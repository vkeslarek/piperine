//! A node chosen at elaboration (part I §1.4.7, user decision of 2026-11-24): the param `k` picks which node `Pick` probes, which
//! it drives and which its load connects to. The expected values are computed by Rust in `source_templates.rs`.

/// A conductance between two nodes.
module Load(p: Electrical, n: Electrical) { g: f64 = 1.0; }
analog for Load { i(p, n) +> v(p, n) * g; }

/// Drives `level` with the line `k` picks, holds the target `k` picks at 0.3, and loads the line `k` does not pick.
module Pick(a: Electrical, b: Electrical, level: Electrical, t1: Electrical, t2: Electrical) {
    k: f64 = 1.0;
    let load = Load(if k > 0.5 { b } else { a }, gnd);
}
analog for Pick {
    potential(level) +> v(if k > 0.5 { a } else { b });
    v(if k > 0.5 { t1 } else { t2 }) +> 0.3;
}

module RigChoices() {
    signal a: Electrical;
    signal b: Electrical;
    signal l1: Electrical;
    signal l2: Electrical;
    signal t1: Electrical;
    signal t2: Electrical;
    signal u1: Electrical;
    signal u2: Electrical;
    let one = Pick(a, b, l1, t1, t2) { k: 1.0 };
    let zero = Pick(a, b, l2, u1, u2) { k: 0.0 };
}
analog for RigChoices {
    potential(a) +> 0.2;
    potential(b) +> 0.8;
    i(t2, gnd) +> v(t2, gnd);
    i(u1, gnd) +> v(u1, gnd);
}
