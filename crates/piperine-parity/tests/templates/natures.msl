//! A template of a module generic over the nature of its ports (part III §8.4.3): its type `Load<Electrical>` names the
//! argument, so a placement through a `const` or a param of that type connects nodes of that nature. The expected values are
//! computed by Rust in `source_templates.rs`.

/// A conductance between two nodes of any nature.
module Load<K: Nature>(p: K, n: K) { g: f64 = 1.0; }
analog<K> for Load<K> { flow(p, n) +> potential(p, n) * g; }

const HALF: Load<Electrical> = Load::<Electrical> { g: 0.5 };

/// A divider whose lower leg is placed through the param `leg`, of the type `Load<Electrical>`.
module Divider(top: Electrical, mid: Electrical) {
    leg: Load<Electrical>;
    let upper = HALF(top, mid);
    let lower = leg(mid, gnd);
}

module RigNatures() {
    signal top: Electrical;
    signal mid: Electrical;
    let divider = Divider(top, mid) { leg: Load::<Electrical> { g: 2.0 } };
}
analog for RigNatures { potential(top) +> 1.0; }
