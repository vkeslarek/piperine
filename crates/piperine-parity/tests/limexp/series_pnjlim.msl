//! `tests/e2e/twins/diode_series.msl` with its diodes written with `pnjlim`: two series diodes
//! behind 1 kOhm from 5 V (the twin of ngspice's `diode_series.cir`).

/// Independent voltage source (the twins' `Vsource`).
module Vsource(p: Electrical, n: Electrical) {
    dc: f64 = 0.0;
}
analog for Vsource { v(p, n) +> dc * source_scale(); }

/// Ideal resistor (the twins' `Resistor`).
module Resistor(p: Electrical, n: Electrical) {
    r: f64 where r > 0.0;
}
analog for Resistor { i(p, n) +> v(p, n) / r; }

/// Junction diode of the twin `Diode`: `exp` of a junction voltage limited by `pnjlim`.
module DiodePnjlim(a: Electrical, k: Electrical) {
    is: f64 = 1e-14 where is > 0.0;
    n: f64 = 1.0 where n > 0.0;
}
analog for DiodePnjlim {
    let nvt   = n * vt(temperature().unwrap_or(AMBIENT_TEMPERATURE));
    let vcrit = nvt * (nvt / (2.0_f64.sqrt() * is)).ln();
    let vd    = limit(v(a, k), |new, old| pnjlim(new, old, nvt, vcrit), vcrit);
    i(a, k) +> is * ((vd / nvt).exp() - 1.0) + gmin() * vd;
}

module DiodeSeries() {
    signal vin: Electrical;
    signal a: Electrical;
    signal b: Electrical;
    let v1 = Vsource { dc: 5.0 }(vin, gnd);
    let r1 = Resistor { r: 1k }(vin, a);
    let d1 = DiodePnjlim { is: 1e-14, n: 1.0 }(a, b);
    let d2 = DiodePnjlim { is: 1e-14, n: 1.0 }(b, gnd);
}
