//! `&&` and `||` over a left operand that may be unknown (US-04 AC 8, §3.3.12). `u` is never
//! driven, `t` and `f` are true and false, `n0` is 0 and `n2` is 2. A right operand holding
//! `10 / n` can panic (`n0`) and a block holding `emit!` emits a record. A 1 GHz oscillator gives the
//! rising edges the probe runs on.

/// A free-running oscillator, its first change at half a period.
pub module Osc(out clk: Bit = false) {
    f: f64 = 200M where f > 0.0;
}
digital for Osc { on clk.changed() { clk <- !clk after 0.5 / f; } }

/// Each record holds the operators over one left operand.
module Probe(in clk: Bit, in u: Bit, in t: Bit, in f: Bit, in n0: Bit<u8>, in n2: Bit<u8>) {}
digital for Probe {
    on clk.rise() {
        emit!("and", decided = u && (10 / n2 > 5), unknown = u && (10 / n2 > 1), panics = u && (10 / n0 > 1),
              skipped = f && (10 / n0 > 1), run = t && (10 / n2 > 1));
        emit!("or", decided = u || (10 / n2 > 1), unknown = u || (10 / n2 > 5), panics = u || (10 / n0 > 1),
              skipped = t || (10 / n0 > 1), run = f || (10 / n2 > 5));
        emit!("emits", unknown_and = u && { emit!("ran", v = true); true },
              unknown_or = u || { emit!("ran", v = false); false });
    }
}

module ShortCircuitBench() {
    signal clk: Bit; signal u: Bit; signal t: Bit = true; signal f: Bit = false;
    signal n0: Bit<u8> = 0; signal n2: Bit<u8> = 2;
    let osc = Osc(clk) { f: 1G };
    let probe = Probe(clk, u, t, f, n0, n2);
}
