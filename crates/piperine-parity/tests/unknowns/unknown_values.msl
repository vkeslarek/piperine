//! `Unknown` as a value a model can write (MSL §3.3.1, §3.3.9, US-01): as the initial value of a
//! signal, in a `const`, and as a committed value. A 1 GHz oscillator gives the rising edges the
//! probes run on (0.5 ns, 1.5 ns, ...).

/// A free-running oscillator, its first change at half a period.
pub module Osc(out clk: Bit = false) {
    f: f64 = 200M where f > 0.0;
}
digital for Osc { on clk.changed() { clk <- !clk after 0.5 / f; } }

const Z: Option<bool> = Some(Unknown);
const W: u8 = Unknown;

/// Reads a carrier declared `= Unknown`, and counts the changes it announces.
module Probe(in clk: Bit, in s: Bit<u8>) {}
digital for Probe {
    on clk.rise() { emit!("probe", known = s.is_known(), value = s.known_or(9)); }
    on s.changed() { emit!("changed"); }
}

/// Reads the consts: `Z` is `Some` of an unknown `bool`, `W` an unknown `u8`; two reads of one
/// const are the same levels.
module Consts(in clk: Bit) {}
digital for Consts {
    on clk.rise() {
        emit!("consts", some = Z.is_some(), z = Z.unwrap_or(false), z_known = Z.unwrap_or(true).is_known(), w = W, w_known = W.is_known());
    }
}

/// `q` holds 5 and is committed `Unknown`.
module Committer(in clk: Bit, out q: Bit<u8> = 5) {}
digital for Committer { on clk.rise() { q <- Unknown; } }

module UnknownBench() {
    signal clk: Bit; signal s: Bit<u8> = Unknown; signal q: Bit<u8>;
    let osc = Osc(clk) { f: 1G };
    let probe = Probe(clk, s);
    let consts = Consts(clk);
    let committer = Committer(clk, q);
}
