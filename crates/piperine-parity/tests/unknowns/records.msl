//! Records written under unknown control (MSL §19 rule 1, US-05): `d` and `v` are never driven,
//! so they stay unknown for the whole run. A 1 GHz oscillator gives the rising edges the
//! reaction runs on (0.5 ns, 1.5 ns, ...).

/// A free-running oscillator, its first change at half a period.
pub module Osc(out clk: Bit = false) {
    f: f64 = 200M where f > 0.0;
}
digital for Osc { on clk.changed() { clk <- !clk after 0.5 / f; } }

/// `unsure` is written on a path that runs only when `d` is true, which is unknown; `sure` is
/// written under known control; a `require` under the unknown `if` is a check that may not have
/// run. `v` is unknown and `k` is known: each keeps its own flag in the record.
module Recording(in clk: Bit, in d: Bit, in v: Bit<u8>) {}
digital for Recording {
    on clk.rise() {
        if d { emit!("unsure", v = v, k = 3); }
        emit!("sure", v = v, k = 3);
        if d { require("held", true); }
    }
}

module RecordBench() {
    signal clk: Bit; signal d: Bit; signal v: Bit<u8>;
    let osc = Osc(clk) { f: 1G };
    let m = Recording(clk, d, v);
}
