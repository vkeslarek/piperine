//! An `if` expression whose arms commit or emit, used as the value of a commit or of an emit
//! field (MSL §3.3.3). `d` is never driven, so it is unknown for the whole run; a 1 GHz
//! oscillator gives the rising edges (0.5 ns, 1.5 ns, ...).

/// A free-running oscillator, its first change at half a period.
pub module Osc(out clk: Bit = false) {
    f: f64 = 200M where f > 0.0;
}
digital for Osc { on clk.changed() { clk <- !clk after 0.5 / f; } }

/// `v` takes 5 on either path, so it stays known; `w` takes 1 or 2 by path, so it is unknown;
/// `z` takes 3 on either path and `x` is 7 on either, so both stay known; the record is written
/// under known control, so it is no maybe.
module Hoist(in clk: Bit, in d: Bit, out v: Bit<u8> = 0, out w: Bit<u8> = 0, out z: Bit<u8> = 0) {}
digital for Hoist {
    on clk.rise() {
        v <- if d { w <- 1; 5 } else { w <- 2; 5 };
        emit!("seen", x = if d { z <- 3; 7 } else { z <- 3; 7 });
    }
}

module HoistBench() {
    signal clk: Bit; signal d: Bit;
    signal v: Bit<u8>; signal w: Bit<u8>; signal z: Bit<u8>;
    let osc = Osc(clk) { f: 1G };
    let hoist = Hoist(clk, d, v, w, z);
}
