//! Guards (MSL §13 rule 1, US-04 AC 9): `en` is never driven, so a guard on it is unknown;
//! `off` holds false from the start, so a guard on it is known false. A 1 GHz oscillator gives
//! the rising edges (0.5 ns, 1.5 ns, ...).

/// A free-running oscillator, its first change at half a period.
pub module Osc(out clk: Bit = false) {
    f: f64 = 200M where f > 0.0;
}
digital for Osc { on clk.changed() { clk <- !clk after 0.5 / f; } }

/// `changes` holds 1 and is committed 5 (they differ), `keeps` holds 5 and is committed 5.
module Guarded(in clk: Bit, in en: Bit, out changes: Bit<u8> = 1, out keeps: Bit<u8> = 5) {}
digital for Guarded { on clk.rise() && en { changes <- 5; keeps <- 5; } }

/// The same reaction behind a guard that is known false: it never runs.
module Blocked(in clk: Bit, in off: Bit, out changes: Bit<u8> = 1) {}
digital for Blocked { on clk.rise() && off { changes <- 5; } }

module GuardBench() {
    signal clk: Bit; signal en: Bit; signal off: Bit = false;
    signal changes: Bit<u8>; signal keeps: Bit<u8>; signal blocked: Bit<u8>;
    let osc = Osc(clk) { f: 1G };
    let guarded = Guarded(clk, en, changes, keeps);
    let blocked_one = Blocked(clk, off, blocked);
}
