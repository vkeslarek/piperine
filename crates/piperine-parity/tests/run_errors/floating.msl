//! A node joined to the rest of the design only by capacitors: it has no operating point.

pub module Capacitor(p: Electrical, n: Electrical) {
    c: f64 where c >= 0.0;
}
analog for Capacitor { i(p, n) +> ddt(c * v(p, n)); }

module Floating() {
    signal a: Electrical;
    let c1 = Capacitor { c: 1e-12 }(a, gnd);
    let c2 = Capacitor { c: 2e-12 }(a, gnd);
}
