//! `f128` transcendental methods from source (composite-values CV-31 AC 1, Appendix H.2 rule 6): 50 vectors of each, drawn evenly from `piperine-numbers/tests/vectors`.
//! Generated from the table of `tests/source_number_widths.rs`: that test fails when this text differs.

pub module Osc(out clk: Bit = false) { f: f64 = 200M where f > 0.0; }
digital for Osc { on clk.changed() { clk <- !clk after 0.5 / f; } }


