//! A `logic` pattern of 70 characters infers a `Logic<70>`, which has two integer planes wider than 64 bits: it elaborates
//! and runs as a written `Logic<70>` does, and `is_high` of 70 ones commits true.

module Bench() {
    signal clk: Bit = false;
    signal t: Bit = false;
}
digital for Bench {
    on clk.rise() {
        let a = logic("1111111111111111111111111111111111111111111111111111111111111111111111");
        t <- a.is_high();
    }
}
