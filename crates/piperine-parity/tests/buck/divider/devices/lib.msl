//! A dependency crate of the two-crate project fixture (`tests/project.rs`): the two devices a
//! resistor divider places, as `tests/e2e/twins/devices.msl` writes them.

/// Ideal resistor.
pub module Resistor(p: Electrical, n: Electrical) {
    r: f64 where r > 0.0;
}
analog for Resistor { i(p, n) +> v(p, n) / r; }

/// Independent voltage source.
pub module Vsource(p: Electrical, n: Electrical) {
    dc: f64 = 0.0;
}
analog for Vsource { v(p, n) +> dc * source_scale(); }
