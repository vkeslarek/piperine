//! Records from source (T52): the stdlib `Never` on a clock and `log` from a reaction.
use buck::dpwm::Osc;

/// Holds `bad` false for the first two rising edges and drives it true at the third, so a
/// `Never` on the same clock sees it false at edges 1 to 3 and true from edge 4.
module Bad(in clk: Bit, out bad: Bit = false) {
    signal n: Bit<u8> = 0;
}
digital for Bad {
    on clk.rise() {
        let s = n.known_or(0);
        n <- s + 1;
        if s == 2 { bad <- true; }
    }
}

module NeverBench() {
    signal clk: Bit; signal bad: Bit;
    let osc = Osc(clk) { f: 200M };
    let drive = Bad(clk, bad);
    let never = Never(clk, bad);
}

/// Two `log` statements per rising edge.
module Talk(in clk: Bit) {}
digital for Talk {
    on clk.rise() {
        log(Severity::Warning, "x");
        log(Severity::Error, "y");
    }
}

module LogBench() {
    signal clk: Bit;
    let osc = Osc(clk) { f: 200M };
    let talk = Talk(clk);
}
