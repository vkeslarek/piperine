//! Time and timers from source (T51): the stdlib `every`, `now()` and `analysis(Static)` read in
//! reactions, and the edges `rise()` and `fall()` over values that pass through unknown.
use buck::dpwm::Osc;

/// `every(1u, 2u)` in an `on` head: a toggle at 1, 3, 5, 7 and 9 us.
module Timer(out hit: Bit = false) {}
digital for Timer { on every(1u, 2u) { hit <- !hit; } }

/// A reaction that commits `now()` and `analysis(Static)`.
module Stamp(in clk: Bit, out t: Bit<f64>, out s: Bit) {}
digital for Stamp { on clk.changed() { t <- now(); s <- analysis(Static); } }

/// Six commits to one `Bit`, one per rising edge: false, unknown, true, unknown, false, true.
module Walk(in clk: Bit, out q: Bit = false) {
    signal n: Bit<u8> = 0;
}
digital for Walk {
    on clk.rise() {
        let s = n.known_or(0);
        n <- s + 1;
        if s == 0 { q <- false; }
        if s == 1 { q <- Unknown; }
        if s == 2 { q <- true; }
        if s == 3 { q <- Unknown; }
        if s == 4 { q <- false; }
        if s == 5 { q <- true; }
    }
}

/// One count per run of a reaction on `rise()`, one per run of a reaction on `fall()`.
module Rises(in q: Bit, out n: Bit<u8> = 0) {}
digital for Rises { on q.rise() { n <- n.known_or(0) + 1; } }
module Falls(in q: Bit, out n: Bit<u8> = 0) {}
digital for Falls { on q.fall() { n <- n.known_or(0) + 1; } }

module TimerBench() {
    signal hit: Bit;
    let timer = Timer(hit);
}
module StampBench() {
    signal clk: Bit; signal t: Bit<f64>; signal s: Bit;
    let osc = Osc(clk) { f: 200M };
    let stamp = Stamp(clk, t, s);
}
module EdgeBench() {
    signal clk: Bit; signal q: Bit; signal r: Bit<u8>; signal f: Bit<u8>;
    let osc = Osc(clk) { f: 200M };
    let walk = Walk(clk, q);
    let rises = Rises(q, r);
    let falls = Falls(q, f);
}
