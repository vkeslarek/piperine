//! `inertial` (§22.5.8) over two enums with a `Default`: `T` is bound by `Default` (rule 7), which
//! `bool` and the integers do not implement (§3.3.4). The input changes at the instants of the table in
//! `source_stdlib_generic.rs`; the result is recorded every ns, half a ns after the instants the table uses. The expected output is computed there by Rust.

#[derive(Repr, PartialEq)]
enum Level { Low, Mid, High }
impl Default for Level { fn default() -> Level { Level::Low } }

#[derive(Repr, PartialEq)]
enum Mode { Idle, Run }
impl Default for Mode { fn default() -> Mode { Mode::Idle } }

module LevelBench() {
    signal x: Bit<Level> = Level::Low;
    let y = inertial(x, 5n);
}
digital for LevelBench {
    on at(10n) { x <- Level::Mid; }
    on at(30n) { x <- Level::Low; }
    on at(50n) { x <- Level::High; }
    on at(53n) { x <- Level::Mid; }
    on at(70n) { x <- Level::High; }
    on at(76n) { x <- Level::Low; }
    on every(0.5n, 1n) { emit!("y", value = y); }
}

module ModeBench() {
    signal x: Bit<Mode> = Mode::Idle;
    let y = inertial(x, 5n);
}
digital for ModeBench {
    on at(10n) { x <- Mode::Run; }
    on at(30n) { x <- Mode::Idle; }
    on at(50n) { x <- Mode::Run; }
    on at(53n) { x <- Mode::Idle; }
    on at(70n) { x <- Mode::Run; }
    on at(76n) { x <- Mode::Idle; }
    on every(0.5n, 1n) { emit!("y", value = y); }
}
