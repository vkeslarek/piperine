//! `cross` with `ttol` and `etol` (FIX-12): the three spellings, and an RC charge.

/// A node ramping at 1 V per microsecond.
module Ramp(p: Electrical) {}
analog for Ramp { v(p, gnd) +> now() * 1.0e6; }

/// The three spellings, each committing `true` at the crossing of 0.5 V.
module Spellings(a: Electrical, out one: Bit = false, out two: Bit = false, out three: Bit = false) {}
digital for Spellings {
    on cross(v(a) - 0.5, 1p) { one <- true; }
    on cross(v(a) - 0.5, etol: 1u) { two <- true; }
    on cross(v(a) - 0.5, 1p, 1u) { three <- true; }
}

module SpellingsBench() {
    signal a: Electrical;
    signal one: Bit; signal two: Bit; signal three: Bit;
    let r = Ramp(a);
    let s = Spellings(a, one, two, three);
}

/// A step of 1 V after time 0.
module Step(p: Electrical) {}
analog for Step { v(p, gnd) +> if now() > 0.0 { 1.0 } else { 0.0 }; }

module Resistor(p: Electrical, n: Electrical) { r: f64 where r > 0.0; }
analog for Resistor { i(p, n) +> v(p, n) / r; }

module Capacitor(p: Electrical, n: Electrical) { c: f64 where c > 0.0; }
analog for Capacitor { i(p, n) +> ddt(c * v(p, n)); }

/// Commits `true` when the capacitor voltage crosses 0.5 V, with a `ttol` of 1 ns.
module Watch(a: Electrical, out hit: Bit = false) { tol: f64 = 1n; }
digital for Watch { on cross(v(a) - 0.5, tol) { hit <- true; } }

/// R = 1 kΩ, C = 1 nF: RC = 1 µs.
module RcBench() {
    signal x: Electrical;
    signal a: Electrical;
    signal hit: Bit;
    let s = Step(x);
    let r = Resistor { r: 1k }(x, a);
    let c = Capacitor { c: 1n }(a, gnd);
    let w = Watch { tol: 1n }(a, hit);
}
