//! The RC of the `ac_rc` and `tran_rc` twins (`tests/e2e/twins/`) written as a top whose input is
//! a node port: the source is the host's (PI-07, D11), not a `Vsource` in the design.

module Resistor(p: Electrical, n: Electrical) {
    r: f64 where r > 0.0;
}
analog for Resistor { i(p, n) +> v(p, n) / r; }

module Capacitor(p: Electrical, n: Electrical) {
    c: f64 where c >= 0.0;
}
analog for Capacitor { i(p, n) +> ddt(c * v(p, n)); }

module RcTop(vin: Electrical) {
    signal r#out: Electrical = 0.0;
    let r1 = Resistor { r: 1000.0 }(vin, r#out);
    let c1 = Capacitor { c: 1.5915494309189535e-9 }(r#out, gnd);
}
