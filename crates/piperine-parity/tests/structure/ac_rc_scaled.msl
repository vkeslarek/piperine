//! The `ac_rc` twin (`tests/ngspice/ac_rc.msl`) with the capacitor written
//! `i(p, n) +> 2.0 * ddt(0.5 * c * v(p, n));` (AS-07 AC 1).

module Resistor(p: Electrical, n: Electrical) {
    r: f64 where r > 0.0;
}
analog for Resistor { i(p, n) +> v(p, n) / r; }

module Vsource(p: Electrical, n: Electrical) {
    dc: f64 = 0.0;
    ac: f64 = 0.0;
}
analog for Vsource { v(p, n) +> dc * source_scale() + ac_stim(ac); }

module Capacitor(p: Electrical, n: Electrical) {
    c: f64 where c >= 0.0;
}
analog for Capacitor { i(p, n) +> 2.0 * ddt(0.5 * c * v(p, n)); }

module AcRc() {
    signal vin: Electrical;
    signal r#out: Electrical;
    let v1 = Vsource { dc: 0.0, ac: 1.0 }(vin, gnd);
    let r1 = Resistor { r: 1000.0 }(vin, r#out);
    let c1 = Capacitor { c: 1.5915494309189535e-9 }(r#out, gnd);
}
