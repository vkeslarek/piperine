//! Contributions under `if` and `match`, and switch branches (analog-structure AS-01, AS-03),
//! each a few lines with the value its spec rule gives.

/// Ideal resistor.
module Resistor(p: Electrical, n: Electrical) {
    r: f64 where r > 0.0;
}
analog for Resistor { i(p, n) +> v(p, n) / r; }

/// A potential held at `volts`.
module Level(p: Electrical) { volts: f64 = 0.0; }
analog for Level { v(p, gnd) +> volts; }

/// A source of `amps` into `p`.
module Pump(p: Electrical) { amps: f64 = 1m; }
analog for Pump { i(gnd, p) +> amps; }

/// A source of `volts` at `p`, with a unit AC stimulus on top (it adds nothing outside a sweep).
module Battery(p: Electrical) { volts: f64 = 1.0; }
analog for Battery { v(p, gnd) +> volts + ac_stim(1.0); }

/// A free-running oscillator, its first change at half a period: a rise at 1 us for `f` = 500 kHz.
pub module Osc(out clk: Bit = false) {
    f: f64 = 500k where f > 0.0;
}
digital for Osc { on clk.changed() { clk <- !clk after 0.5 / f; } }

// -- AS-01 AC 1: a flow contribution in each arm of an `if` on a probe

module Halved(a: Electrical) {}
analog for Halved {
    if v(a) > 0.5 { i(a, gnd) +> v(a) / 1k; } else { i(a, gnd) +> v(a) / 2k; }
}

module HalvedBench() {
    signal a: Electrical;
    let load = Halved(a);
    let source = Pump { amps: 1m }(a);
}

// -- AS-01 AC 2: a `match` on a `Bit<Mode>` carrier

#[derive(Repr, PartialEq)]
enum Mode { Fast, Slow }

module Moded(a: Electrical, in mode: Bit<Mode>) {}
analog for Moded {
    match mode {
        Mode::Fast => { i(a, gnd) +> v(a) / 1k; }
        Mode::Slow => { i(a, gnd) +> v(a) / 2k; }
    }
}

module FastBench() {
    signal a: Electrical;
    signal mode: Bit<Mode> = Mode::Fast;
    let load = Moded(a, mode);
    let source = Pump { amps: 1m }(a);
}

module SlowBench() {
    signal a: Electrical;
    signal mode: Bit<Mode> = Mode::Slow;
    let load = Moded(a, mode);
    let source = Pump { amps: 1m }(a);
}

// -- AS-01 AC 4: no enabled contribution is zero flow

module Gated(a: Electrical, in en: Bit) {}
analog for Gated { if en { i(a, gnd) +> v(a) / 1k; } }

module GatedLowBench() {
    signal a: Electrical;
    signal en: Bit = false;
    let gate = Gated(a, en);
    let leak = Resistor { r: 1M }(a, gnd);
    let source = Pump { amps: 1m }(a);
}

module GatedHighBench() {
    signal a: Electrical;
    signal en: Bit = true;
    let gate = Gated(a, en);
    let leak = Resistor { r: 1M }(a, gnd);
    let source = Pump { amps: 1m }(a);
}

// -- Edge case: two enabled flow arms sum (§11 rule 1)

module Twice(a: Electrical, in en: Bit) {}
analog for Twice {
    if en { i(a, gnd) +> v(a) / 1k; }
    if en { i(a, gnd) +> v(a) / 1k; }
}

module TwiceBench() {
    signal a: Electrical;
    signal en: Bit = true;
    let gate = Twice(a, en);
    let source = Pump { amps: 1m }(a);
}

// -- AS-03: the ideal switch of §11, behind 1 kOhm from 1 V

module Switch(a: Electrical, b: Electrical, in ctl: Bit) {}
analog for Switch {
    if ctl { v(a, b) +> 0.0; } else { i(a, b) +> 0.0; }
}

module SwitchBench() {
    signal s: Electrical;
    signal a: Electrical;
    signal ctl: Bit;
    let osc = Osc(ctl) { f: 500k };
    let source = Battery { volts: 1.0 }(s);
    let series = Resistor { r: 1k }(s, a);
    let sw = Switch(a, gnd, ctl);
}

// -- AS-03 AC 3: both kinds enabled in one solve

module Both(a: Electrical, in en: Bit) {}
analog for Both {
    if en { v(a, gnd) +> 1.0; i(a, gnd) +> 1m; }
}

module BothBench() {
    signal a: Electrical;
    signal en: Bit = true;
    let both = Both(a, en);
    let leak = Resistor { r: 1k }(a, gnd);
}

// -- AS-03 AC 4: an AC sweep takes the kind `analysis(Static)` false gives

module Linearized(a: Electrical) {}
analog for Linearized {
    if analysis(Static) { i(a, gnd) +> 0.0; } else { v(a, gnd) +> 0.0; }
}

module SweepBench() {
    signal s: Electrical;
    signal a: Electrical;
    let source = Battery { volts: 1.0 }(s);
    let series = Resistor { r: 1k }(s, a);
    let sw = Linearized(a);
}

// -- AS-06: guarded `limit`, `ac_stim` and `bound_step`, and sites that read a carrier

/// A limiter that never lets the iterate move: whenever it runs, the limited value is the last one,
/// so the solver vetoes every iterate that proposes another. A `limit` that does not run neither
/// vetoes nor moves.
module Stubborn(a: Electrical, in en: Bit) {}
analog for Stubborn {
    let x = if en { limit(v(a), |new, old| old) } else { 0.0 };
    i(a, gnd) +> x + v(a) / 1k;
}

module StubbornOffBench() {
    signal a: Electrical;
    signal en: Bit = false;
    let load = Stubborn(a, en);
    let source = Pump { amps: 1m }(a);
}

module StubbornOnBench() {
    signal a: Electrical;
    signal en: Bit = true;
    let load = Stubborn(a, en);
    let source = Pump { amps: 1m }(a);
}

/// The junction of the twins, its limiter under the enable `en`: off, it carries nothing.
module GatedJunction(a: Electrical, k: Electrical, in en: Bit) {
    is: f64 = 1e-14;
}
analog for GatedJunction {
    let nvt = vt();
    let vcrit = nvt * (nvt / (2.0_f64.sqrt() * is)).ln();
    if en {
        let vd = limit(v(a, k), |new, old| pnjlim(new, old, nvt, vcrit), vcrit);
        i(a, k) +> is * ((vd / nvt).exp() - 1.0) + gmin() * vd;
    }
}

/// The same junction with no enable: the operating point the gated one must reach.
module Junction(a: Electrical, k: Electrical) {
    is: f64 = 1e-14;
}
analog for Junction {
    let nvt = vt();
    let vcrit = nvt * (nvt / (2.0_f64.sqrt() * is)).ln();
    let vd = limit(v(a, k), |new, old| pnjlim(new, old, nvt, vcrit), vcrit);
    i(a, k) +> is * ((vd / nvt).exp() - 1.0) + gmin() * vd;
}

module GatedJunctionBench() {
    signal s: Electrical;
    signal a: Electrical;
    signal en: Bit;
    let osc = Osc(en) { f: 500k };
    let source = Level { volts: 5.0 }(s);
    let series = Resistor { r: 1k }(s, a);
    let diode = GatedJunction(a, gnd, en);
}

module JunctionBench() {
    signal s: Electrical;
    signal a: Electrical;
    let source = Level { volts: 5.0 }(s);
    let series = Resistor { r: 1k }(s, a);
    let diode = Junction(a, gnd);
}

/// A `limit` over the sum of a carrier and a probe, through a limiter that damps its step (it has the
/// input as its fixed point, so the converged value is the sum): `lv` + half of `v(a)` into 1 kOhm
/// from 1 mA per volt.
module CarrierLimited(a: Electrical, in lv: Bit<f64>) {}
analog for CarrierLimited { i(gnd, a) +> limit(lv + 0.5 * v(a), |new, old| old + 0.5 * (new - old)) * 1m; }

module CarrierLimitBench() {
    signal a: Electrical;
    signal lv: Bit<f64> = 2.0;
    let source = CarrierLimited(a, lv);
    let load = Resistor { r: 1k }(a, gnd);
}

/// A unit AC stimulus that is there only when `en` is high.
module GatedStim(a: Electrical, in en: Bit) {}
analog for GatedStim { v(a, gnd) +> if en { ac_stim(1.0) } else { 0.0 }; }

module StimOnBench() {
    signal a: Electrical;
    signal en: Bit = true;
    let source = GatedStim(a, en);
}

module StimOffBench() {
    signal a: Electrical;
    signal en: Bit = false;
    let source = GatedStim(a, en);
}

/// A unit AC stimulus on the flow, in a statement `if`: 1 mA into 1 kOhm when `en` is high.
module GatedFlowStim(a: Electrical, in en: Bit) {}
analog for GatedFlowStim { if en { i(a, gnd) +> ac_stim(1m); } }

module FlowStimOnBench() {
    signal a: Electrical;
    signal en: Bit = true;
    let source = GatedFlowStim(a, en);
    let load = Resistor { r: 1k }(a, gnd);
}

module FlowStimOffBench() {
    signal a: Electrical;
    signal en: Bit = false;
    let source = GatedFlowStim(a, en);
    let load = Resistor { r: 1k }(a, gnd);
}

/// A stimulus whose magnitude is the carrier `lv`.
module CarrierStim(a: Electrical, in lv: Bit<f64>) {}
analog for CarrierStim { v(a, gnd) +> ac_stim(lv); }

module CarrierStimBench() {
    signal a: Electrical;
    signal lv: Bit<f64> = 3.0;
    let source = CarrierStim(a, lv);
}

/// A slow sine that caps the step at 1 ns once `ctl` is high.
module Capper(p: Electrical, in ctl: Bit) {}
analog for Capper {
    v(p, gnd) +> (2.0 * 3.141592653589793 * 1k * now()).sin();
    if ctl { bound_step(1n); }
}

module CapperBench() {
    signal a: Electrical;
    signal ctl: Bit;
    let osc = Osc(ctl) { f: 500k };
    let source = Capper(a, ctl);
    let load = Resistor { r: 1k }(a, gnd);
}

// -- AS-03 AC 6: a capacitor that starts charged (§16 H7) has a capacitor's admittance in AC

/// The `CapIc` of §16 H7: held at `ic` by the transient's operating point, a capacitor otherwise.
module CapIc(p: Electrical, n: Electrical) {
    c: f64 where c >= 0.0;
    ic: f64 = 0.0;
}
analog for CapIc {
    if analysis(Transient) && analysis(Static) { v(p, n) +> ic; }
    else { i(p, n) +> ddt(c * v(p, n)); }
}

/// 1 V of stimulus behind 1 kOhm into a `CapIc` whose corner is exactly 100 kHz.
module CapIcBench() {
    signal s: Electrical;
    signal a: Electrical;
    let source = Battery { volts: 0.0 }(s);
    let series = Resistor { r: 1k }(s, a);
    let cap = CapIc { c: 1.5915494309189535e-9, ic: 2.0 }(a, gnd);
}
