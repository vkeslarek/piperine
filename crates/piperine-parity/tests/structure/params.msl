//! Param values, initial values and param history (analog-structure AS-12, AS-14, AS-15): a body
//! `let` that computes a child's param, a node or a carrier that starts at a param's value, and the
//! change of a param as an event. Every module is written from the spec text (Part III §8.1).

/// Ideal resistor.
module Resistor(p: Electrical, n: Electrical) {
    r: f64 where r > 0.0;
}
analog for Resistor { i(p, n) +> v(p, n) / r; }

/// Ideal capacitor.
module Capacitor(p: Electrical, n: Electrical) {
    c: f64 where c > 0.0;
}
analog for Capacitor { i(p, n) +> c * ddt(v(p, n)); }

/// A potential held at `volts` with a unit AC stimulus on top.
module AcLevel(p: Electrical) { volts: f64 = 0.0; }
analog for AcLevel { v(p, gnd) +> volts + ac_stim(1.0); }

// -- AS-12 AC 1: a body `let` as a param value

/// A first-order low-pass whose corner `fc` sets the capacitance: `c = 1 / (2 pi r fc)`.
module CornerFilter(a: Electrical, b: Electrical) {
    r: f64 = 1k;
    fc: f64 = 1k;
    let c = 1.0 / (2.0 * 3.141592653589793 * r * fc);
    let series = Resistor { r }(a, b);
    let shunt = Capacitor { c }(b, gnd);
}

module CornerBench() {
    signal a: Electrical;
    signal o: Electrical;
    let source = AcLevel { volts: 0.0 }(a);
    let filter = CornerFilter(a, o);
}

// -- AS-15 AC 2: a node that starts at a param's value

/// An RC low-pass whose node `o` starts at `v0` through the operating point: 1 V behind 1 kOhm into
/// 1 uF (tau = 1 ms).
module StartedBench() {
    v0: f64 = 0.6;
    signal src: Electrical;
    signal o: Electrical = v0;
    let source = Level { volts: 1.0 }(src);
    let series = Resistor { r: 1k }(src, o);
    let shunt = Capacitor { c: 1u }(o, gnd);
}

/// A node with three equilibria: the current into ground is `v^3 - v`, zero at -1, 0 and 1 V. Which one an
/// operating point reaches depends on where Newton starts.
module Bistable(a: Electrical) {}
analog for Bistable { i(a, gnd) +> v(a) * v(a) * v(a) - v(a); }

/// `o` starts at `v0` = 0.6: Newton in an `op` starts there and settles at +1 V.
module BistableBench() {
    v0: f64 = 0.6;
    signal o: Electrical = v0;
    let cell = Bistable(o);
}

/// The same cell started at -0.6 V: it settles at -1 V.
module BistableNegBench() {
    v0: f64 = -0.6;
    signal o: Electrical = v0;
    let cell = Bistable(o);
}

/// A potential held at `volts`.
module Level(p: Electrical) { volts: f64 = 0.0; }
analog for Level { v(p, gnd) +> volts; }

// -- params-and-io PI-01 to PI-03: integer, enum and `Option` params

/// How a load scales its conductance.
#[derive(Repr, PartialEq)]
enum Mode { Fast, Slow }

/// A load of `n` times 1 mS: an integer param read as `n as f64` (PI-01 AC 3).
module CountedLoad(p: Electrical) { n: u8 = 4; }
analog for CountedLoad { i(p, gnd) +> (n as f64) * v(p) / 1k; }

/// A load of 1 mS or 3 mS by the arm its `Mode` param selects (PI-02 AC 1).
module ModedLoad(p: Electrical) { md: Mode = Mode::Fast; }
analog for ModedLoad {
    i(p, gnd) +> match md { Mode::Fast => 1.0, Mode::Slow => 3.0 } * v(p) / 1k;
}

/// A resistor of `rs` ohms, 1 kOhm when `rs` is left out (PI-03 AC 1 and AC 3).
module OptionalLoad(p: Electrical) { rs: Option<f64>; }
analog for OptionalLoad { i(p, gnd) +> v(p) / rs.unwrap_or(1k); }

/// 1 V behind 1 kOhm into `o`: the divider every load below hangs on.
module Supply(o: Electrical) {
    signal src: Electrical;
    let source = Level { volts: 1.0 }(src);
    let series = Resistor { r: 1k }(src, o);
}

module IntegerDefaultBench() { signal o: Electrical; let supply = Supply(o); let load = CountedLoad(o); }
module IntegerBoundBench() { signal o: Electrical; let supply = Supply(o); let load = CountedLoad { n: 7 }(o); }
module EnumDefaultBench() { signal o: Electrical; let supply = Supply(o); let load = ModedLoad(o); }
module EnumBoundBench() { signal o: Electrical; let supply = Supply(o); let load = ModedLoad { md: Mode::Slow }(o); }
module OptionLeftOutBench() { signal o: Electrical; let supply = Supply(o); let load = OptionalLoad(o); }
module OptionSomeBench() { signal o: Electrical; let supply = Supply(o); let load = OptionalLoad { rs: Some(3k) }(o); }
module OptionNoneBench() { signal o: Electrical; let supply = Supply(o); let load = OptionalLoad { rs: None }(o); }

// -- params-and-io PI-02, §8.1.15: an enum param with a payload

/// How a load is described: by its conductance, or by its resistance.
#[derive(Repr, PartialEq)]
enum Rating { Conductance(f64), Resistance(f64) }

/// A load rated either way (the default is 2 mS).
module RatedLoad(p: Electrical) { rating: Rating = Rating::Conductance(2m); }
analog for RatedLoad {
    i(p, gnd) +> match rating { Rating::Conductance(g) => g, Rating::Resistance(r) => 1.0 / r } * v(p);
}

module RatedDefaultBench() { signal o: Electrical; let supply = Supply(o); let load = RatedLoad(o); }
module RatedResistanceBench() { signal o: Electrical; let supply = Supply(o); let load = RatedLoad { rating: Rating::Resistance(250.0) }(o); }

// -- params-and-io PI-03 AC 3: every way to read an `Option` param gives the value of the bound case

/// A resistor of `rs` ohms read by `match`; 1 kOhm when `rs` is `None`.
module MatchLoad(p: Electrical) { rs: Option<f64>; }
analog for MatchLoad { i(p, gnd) +> match rs { Some(r) => v(p) / r, None => v(p) / 1k }; }

/// The same read by `is_some` and `unwrap`.
module IsSomeLoad(p: Electrical) { rs: Option<f64>; }
analog for IsSomeLoad { i(p, gnd) +> if rs.is_some() { v(p) / rs.unwrap() } else { v(p) / 1k }; }

/// The same read by `if let`.
module IfLetLoad(p: Electrical) { rs: Option<f64>; }
analog for IfLetLoad {
    if let Some(r) = rs {
        i(p, gnd) +> v(p) / r;
    } else {
        i(p, gnd) +> v(p) / 1k;
    }
}

module MatchSomeBench() { signal o: Electrical; let supply = Supply(o); let load = MatchLoad { rs: 3k }(o); }
module MatchNoneBench() { signal o: Electrical; let supply = Supply(o); let load = MatchLoad(o); }
module IsSomeSomeBench() { signal o: Electrical; let supply = Supply(o); let load = IsSomeLoad { rs: 3k }(o); }
module IsSomeNoneBench() { signal o: Electrical; let supply = Supply(o); let load = IsSomeLoad(o); }
module IfLetSomeBench() { signal o: Electrical; let supply = Supply(o); let load = IfLetLoad { rs: 3k }(o); }
module IfLetNoneBench() { signal o: Electrical; let supply = Supply(o); let load = IfLetLoad(o); }
