//! `inst.name` and `inflow()` (analog-structure AS-11, AS-13): a parent reads and loads the `pub`
//! items of its children, and a module measures the flow into one of its ports. Every module is
//! written from the spec text (Part III §8.2.8, §6 rule 5).

/// Ideal resistor.
module Resistor(p: Electrical, n: Electrical) {
    r: f64 where r > 0.0;
}
analog for Resistor { i(p, n) +> v(p, n) / r; }

/// A potential held at `volts`.
module Level(p: Electrical) { volts: f64 = 0.0; }
analog for Level { v(p, gnd) +> volts; }

// -- AS-11 AC 1 and 2: a `pub` node of a child

/// Drives its `pub` node `mid` at half of `a`.
module Half(a: Electrical) { pub signal mid: Electrical; }
analog for Half { v(mid) +> 0.5 * v(a); }

module ProbeBench() {
    signal a: Electrical;
    signal o: Electrical;
    let source = Level { volts: 2.0 }(a);
    let c = Half(a);
    let load = Resistor { r: 1k }(o, gnd);
}
analog for ProbeBench { v(o) +> v(c.mid); }

/// A resistor of 1 kOhm from `a` to its `pub` node `mid`.
module Series(a: Electrical) { pub signal mid: Electrical; }
analog for Series { i(a, mid) +> v(a, mid) / 1k; }

module LoadBench() {
    signal a: Electrical;
    signal o: Electrical;
    let source = Level { volts: 2.0 }(a);
    let c = Series(a);
    let load = Resistor { r: 1k }(o, gnd);
}
analog for LoadBench {
    i(c.mid, gnd) +> v(c.mid) / 1k;
    v(o) +> v(c.mid);
}

// -- AS-11 AC 3: a `pub` carrier of a child

/// A `pub` carrier that is 1.0 until 1 us and 3.0 after.
module Counter(a: Electrical) { pub signal state: Bit<f64> = 1.0; }
digital for Counter { on at(1u) { state <- 3.0; } }

module CarrierReadBench() {
    signal a: Electrical;
    signal o: Electrical;
    let source = Level { volts: 0.0 }(a);
    let c = Counter(a);
    let load = Resistor { r: 1k }(o, gnd);
}
analog for CarrierReadBench { v(o) +> c.state.known_or(0.0); }

/// The parent reads the child's `state` in a reaction and in a definition, not only in `analog`.
module CarrierReactionBench() {
    signal a: Electrical;
    signal seen: Bit<f64> = 0.0;
    signal mirror: Bit<f64>;
    let source = Level { volts: 0.0 }(a);
    let c = Counter(a);
    mirror = c.state.known_or(0.0);
}
digital for CarrierReactionBench { on at(2u) { seen <- c.state.known_or(0.0); } }

// -- AS-11 AC 4: a `pub` param and a `pub` let of a child

/// A `pub` param and a `pub` name for three times it.
module Gain(a: Electrical) {
    pub r: f64 = 2.0;
    pub let e = r * 3.0;
}

module ParamBench() {
    k: f64 = 4.0;
    signal a: Electrical;
    signal o: Electrical;
    let source = Level { volts: 0.0 }(a);
    let c = Gain { r: k }(a);
    let load = Resistor { r: 1k }(o, gnd);
}
analog for ParamBench { v(o) +> c.r + c.e; }

// -- AS-13: `p.inflow()`

/// A potential held at `volts` with a unit AC stimulus on top.
module AcLevel(p: Electrical) { volts: f64 = 0.0; }
analog for AcLevel { v(p, gnd) +> volts + ac_stim(1.0); }

/// Draws 1 mA at `p` and `v(p, n) / 1k` from `p` to `n`; `o` is held at 1 kOhm times the flow at `p`.
module Meter(p: Electrical, n: Electrical, o: Electrical) {}
analog for Meter {
    i(p, gnd) +> 1m;
    i(p, n) +> v(p, n) / 1k;
    v(o) +> p.inflow() * 1k;
}

module MeterBench() {
    signal p: Electrical;
    signal n: Electrical;
    signal o: Electrical;
    let high = Level { volts: 2.0 }(p);
    let low = Level { volts: 1.0 }(n);
    let meter = Meter(p, n, o);
    let load = Resistor { r: 1k }(o, gnd);
}

/// Draws 2 mA at `p`.
module Sink(p: Electrical) {}
analog for Sink { i(p, gnd) +> 2m; }

/// Draws 1 mA at `p` itself and 2 mA through its child `Sink`.
module Outer(p: Electrical, o: Electrical) {
    let sink = Sink(p);
}
analog for Outer {
    i(p, gnd) +> 1m;
    v(o) +> p.inflow() * 1k;
}

module ChildBench() {
    signal p: Electrical;
    signal o: Electrical;
    let source = Level { volts: 1.0 }(p);
    let outer = Outer(p, o);
    let load = Resistor { r: 1k }(o, gnd);
}

/// Draws `v(p) / 1k` at `p`; `o` is held at 1 kOhm times the flow at `p`.
module Ohmic(p: Electrical, o: Electrical) {}
analog for Ohmic {
    i(p, gnd) +> v(p) / 1k;
    v(o) +> p.inflow() * 1k;
}

module InflowAcBench() {
    signal p: Electrical;
    signal o: Electrical;
    let source = AcLevel { volts: 0.0 }(p);
    let ohmic = Ohmic(p, o);
    let load = Resistor { r: 1k }(o, gnd);
}

/// Holds `p` at 0 V (a zero-potential branch the merge of §11 rule 3 would fold into ground) and
/// reads the flow that does it.
module Short(p: Electrical, o: Electrical) {}
analog for Short {
    v(p) +> 0.0;
    v(o) +> p.inflow() * 1k;
}

module ShortBench() {
    signal a: Electrical;
    signal p: Electrical;
    signal o: Electrical;
    let supply = Level { volts: 2.0 }(a);
    let feed = Resistor { r: 1k }(a, p);
    let short = Short(p, o);
    let load = Resistor { r: 1k }(o, gnd);
}
