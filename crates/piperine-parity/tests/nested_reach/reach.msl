/// A cell by name in generation, 3 levels: the cell is `p.rows.cells[1]`, at `k = 1 + 1`.
module RigRows3() {
    signal a: Electrical; signal sn_read: Electrical; signal vs_read: Electrical; signal q_read: Electrical; signal k_read: Electrical; signal twice_read: Electrical;
    let p = Tower(a);
}
analog for RigRows3 {
    potential(a) +> 1.0;
    potential(sn_read) +> v(p.rows.cells[1].sn);
    potential(vs_read) +> p.rows.cells[1].vs;
    potential(q_read) +> p.rows.cells[1].q;
    potential(k_read) +> p.rows.cells[1].k;
    potential(twice_read) +> p.rows.cells[1].twice;
}

/// A cell by name in generation, 4 levels: the cell is `p.tower.rows.cells[1]`, at `k = 1 + 1`.
module RigRows4() {
    signal a: Electrical; signal sn_read: Electrical; signal vs_read: Electrical; signal q_read: Electrical; signal k_read: Electrical; signal twice_read: Electrical;
    let p = Tall(a);
}
analog for RigRows4 {
    potential(a) +> 1.0;
    potential(sn_read) +> v(p.tower.rows.cells[1].sn);
    potential(vs_read) +> p.tower.rows.cells[1].vs;
    potential(q_read) +> p.tower.rows.cells[1].q;
    potential(k_read) +> p.tower.rows.cells[1].k;
    potential(twice_read) +> p.tower.rows.cells[1].twice;
}

/// Two wrappers, each wired to the other's cell node three levels down, fed 1 A at `p.mid.c0.sn`.
module RigPair3() {
    let p = Level3(q.mid.c0.sn);
    let q = Level3(p.mid.c0.sn);
    let feed = Feed(p.mid.c0.sn);
}

/// A wrapper wired to its own cell's node four levels down, fed 1 A there.
module RigOwn4() {
    let p = Level4(p.top.mid.c0.sn);
    let feed = Feed(p.top.mid.c0.sn);
}

/// Two wrappers through templates, four levels down, each wired to the other's cell node, fed 1 A at `p.block.bank.c0.sn`.
module RigPair4() {
    let p = Wing { cell: Cell { } }(q.block.bank.c0.sn);
    let q = Wing { cell: Cell { } }(p.block.bank.c0.sn);
    let feed = Feed(p.block.bank.c0.sn);
}

/// Two wrappers through templates and a generation, four levels down, each wired to the other's second cell's node, fed 1 A at
/// `p.grid.row.cells[1].sn`; each wrapper has two cells, `cells[0]` and `cells[1]`, on the node it is wired to.
module RigPairGeneration4() {
    let p = Plane { cell: Cell { } }(q.grid.row.cells[1].sn);
    let q = Plane { cell: Cell { } }(p.grid.row.cells[1].sn);
    let feed = Feed(p.grid.row.cells[1].sn);
}

/// Through generic templates (a type parameter placing a generic module), 3 levels: the cell is `p.bank.c0`, at `k = 2`.
module RigGeneric3() {
    signal a: Electrical; signal sn_read: Electrical; signal vs_read: Electrical; signal q_read: Electrical; signal k_read: Electrical; signal twice_read: Electrical;
    let p = GBlock::<_>(a) { cell: Cell { k: 2.0 } };
}
analog for RigGeneric3 {
    potential(a) +> 1.0;
    potential(sn_read) +> v(p.bank.c0.sn);
    potential(vs_read) +> p.bank.c0.vs;
    potential(q_read) +> p.bank.c0.q;
    potential(k_read) +> p.bank.c0.k;
    potential(twice_read) +> p.bank.c0.twice;
}

