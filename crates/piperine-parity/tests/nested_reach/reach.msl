    potential(k_read) +> p.block.bank.c0.k;
    potential(twice_read) +> p.block.bank.c0.twice;
}

/// A template in generation, 3 levels: the cell is `p.row.cells[1]`, at `k = 4`.
module RigRow3() {
    signal a: Electrical; signal sn_read: Electrical; signal vs_read: Electrical; signal q_read: Electrical; signal k_read: Electrical; signal twice_read: Electrical;
    let p = Grid { cell: Cell { k: 4.0 } }(a);
}
analog for RigRow3 {
    potential(a) +> 1.0;
    potential(sn_read) +> v(p.row.cells[1].sn);
    potential(vs_read) +> p.row.cells[1].vs;
    potential(q_read) +> p.row.cells[1].q;
    potential(k_read) +> p.row.cells[1].k;
    potential(twice_read) +> p.row.cells[1].twice;
}

/// A template in generation, 4 levels: the cell is `p.grid.row.cells[1]`, at `k = 5`.
module RigRow4() {
    signal a: Electrical; signal sn_read: Electrical; signal vs_read: Electrical; signal q_read: Electrical; signal k_read: Electrical; signal twice_read: Electrical;
