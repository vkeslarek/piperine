//! Items of a cell read three and four levels below the reader (part III §8.2.8, §8.4.8): a node, a `let` over the solve, a carrier,
//! a param and a `let` over the params, by name, through templates and in generation. The expected values are computed by Rust in
//! `source_nested_reach.rs`.

/// A branch of conductance `k` from `a` to the storage node `sn`, a 1 S leak from it to ground, and what a parent reads of it.
module Cell(a: Electrical) {
    pub k: f64 = 1.0;
    pub let twice = k * 2.0;
    pub signal sn: Electrical;
    pub let vs = v(sn);
    pub signal q: Bit<f64> = 2.5;
}
analog for Cell { i(a, sn) +> v(a, sn) * k; i(sn, gnd) +> v(sn, gnd); }

module Level2(a: Electrical) { pub let c0 = Cell(a); }
module Level3(a: Electrical) { pub let mid = Level2(a); }
module Level4(a: Electrical) { pub let top = Level3(a); }
module Bank(a: Electrical) { cell: Cell; pub let c0 = cell(a); }
module Block(a: Electrical) { cell: Cell; pub let bank = Bank { cell: cell }(a); }
module Wing(a: Electrical) { cell: Cell; pub let block = Block { cell: cell }(a); }
module Row(a: Electrical) { cell: Cell; for j in 0..2 { pub let cells = cell(a); } }
module Grid(a: Electrical) { cell: Cell; pub let row = Row { cell: cell }(a); }
module Plane(a: Electrical) { cell: Cell; pub let grid = Grid { cell: cell }(a); }
module GBank<C: Fn(Electrical)>(a: Electrical) { cell: C; pub let c0 = cell(a); }
module GBlock<C: Fn(Electrical)>(a: Electrical) { cell: C; pub let bank = GBank::<_>(a) { cell: cell }; }
module GWing<C: Fn(Electrical)>(a: Electrical) { cell: C; pub let block = GBlock::<_>(a) { cell: cell }; }
module GRow<C: Fn(Electrical)>(a: Electrical) { cell: C; for j in 0..2 { pub let cells = cell(a); } }
module GGrid<C: Fn(Electrical)>(a: Electrical) { cell: C; pub let row = GRow::<_>(a) { cell: cell }; }
module GPlane<C: Fn(Electrical)>(a: Electrical) { cell: C; pub let grid = GGrid::<_>(a) { cell: cell }; }
module Rows(a: Electrical) { for j in 0..2 { pub let cells = Cell(a) { k: 1.0 + (j as f64) }; } }
module Tower(a: Electrical) { pub let rows = Rows(a); }
module Tall(a: Electrical) { pub let tower = Tower(a); }

/// Feeds `amps` into its node.
module Feed(a: Electrical) { amps: f64 = 1.0; }
analog for Feed { i(a, gnd) +> -amps; }

/// Level3 by name: the cell is `p.mid.c0`, at `k = 1`.
module RigName3() {
    signal a: Electrical; signal sn_read: Electrical; signal vs_read: Electrical; signal q_read: Electrical; signal k_read: Electrical; signal twice_read: Electrical;
    let p = Level3(a);
}
analog for RigName3 {
    potential(a) +> 1.0;
    potential(sn_read) +> v(p.mid.c0.sn);
    potential(vs_read) +> p.mid.c0.vs;
    potential(q_read) +> p.mid.c0.q;
    potential(k_read) +> p.mid.c0.k;
    potential(twice_read) +> p.mid.c0.twice;
}

/// Level4 by name: the cell is `p.top.mid.c0`, at `k = 1`.
module RigName4() {
    signal a: Electrical; signal sn_read: Electrical; signal vs_read: Electrical; signal q_read: Electrical; signal k_read: Electrical; signal twice_read: Electrical;
    let p = Level4(a);
}
analog for RigName4 {
    potential(a) +> 1.0;
    potential(sn_read) +> v(p.top.mid.c0.sn);
    potential(vs_read) +> p.top.mid.c0.vs;
    potential(q_read) +> p.top.mid.c0.q;
    potential(k_read) +> p.top.mid.c0.k;
    potential(twice_read) +> p.top.mid.c0.twice;
}

/// Through templates, 3 levels: the cell is `p.bank.c0`, at `k = 2`.
module RigTemplate3() {
    signal a: Electrical; signal sn_read: Electrical; signal vs_read: Electrical; signal q_read: Electrical; signal k_read: Electrical; signal twice_read: Electrical;
    let p = Block { cell: Cell { k: 2.0 } }(a);
}
analog for RigTemplate3 {
    potential(a) +> 1.0;
    potential(sn_read) +> v(p.bank.c0.sn);
    potential(vs_read) +> p.bank.c0.vs;
    potential(q_read) +> p.bank.c0.q;
    potential(k_read) +> p.bank.c0.k;
    potential(twice_read) +> p.bank.c0.twice;
}

