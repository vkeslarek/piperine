//! Composite params of a template (generics phase E fix round 1, part III §8.3.12, §8.4.1, §3.2.10): a template of a module carries an
//! array, an `Option` and an array of `Option`s as its params, and a placement through it reads them. `Mix` has a result and
//! `Gain` has none; each is placed by name with its defaults and through a template that gives every composite param its own value.

module Mix(x: u8) -> u8 {
    c: [u8; 2] = [1, 2];
    o: Option<u8> = Some(3);
    os: [Option<u8>; 2] = [Some(4), None];
    x * c[1] + o.unwrap_or(0) + os[0].unwrap_or(0) + os[1].unwrap_or(9)
}

module Gain(in a: Bit<u8>, out y: Bit<u8>) {
    c: [u8; 2] = [1, 2];
    y = a * c[1];
}

module Bench() {
    signal a: Bit<u8> = 2;
    signal by_name: Bit<u8>;
    signal by_template: Bit<u8>;
    signal gained_name: Bit<u8>;
    signal gained_template: Bit<u8>;
    let t = Mix { c: [5, 6], o: None, os: [None, Some(1)] };
    let m = Mix(a);
    let n = t(a);
    by_name = m;
    by_template = n;
    let g = Gain { c: [7, 8] };
    let h = Gain(a, gained_name);
    let i = g(a, gained_template);
}

digital for Bench {
    on at(1n) { a <- 3; }
}
