//! A param declared as an array of templates (generics GN-17, T121, part III §8.1, §8.4.1, §8.4.4): `Bank` places `fs[k](a)` for each
//! element of its param `fs`, so line `k` is `a * m` of the element; `d` keeps the default; `l`, `c` and `x` override it by a
//! literal, by a `const` and by a choice of two arrays. `Pick` declares the same param in a module with a result (§8.3.12): its
//! result is `fs[1](x)`, so `pd`, `pl` and `pc` are `a * m` of the second element of the default, of a literal and of a `const`.

module Scale(x: u8) -> u8 {
    m: u8 = 1;
    x * m
}

const TRIPLE: [Scale; 2] = [Scale { m: 3 }, Scale { m: 7 }];

module Bank(in a: Bit<u8>) {
    signal y: [Bit<u8>; 2];
    fs: [Scale; 2] = [Scale { m: 1 }, Scale { m: 2 }];
    for k in 0..2 {
        let scaled = fs[k](a);
        y[k] = scaled;
    }
}

module Pick(x: u8) -> u8 {
    fs: [Scale; 2] = [Scale { m: 1 }, Scale { m: 2 }];
    fs[1](x)
}

module Bench() {
    signal a: Bit<u8> = 3;
    let d = Bank(a);
    let l = Bank(a) { fs: [Scale { m: 5 }, Scale { m: 6 }] };
    let c = Bank(a) { fs: TRIPLE };
    let x = Bank(a) { fs: if true { [Scale { m: 9 }, Scale { m: 4 }] } else { TRIPLE } };
    signal pd: Bit<u8>;
    signal pl: Bit<u8>;
    signal pc: Bit<u8>;
    let by_default = Pick(a);
    let by_literal = Pick(a) { fs: [Scale { m: 5 }, Scale { m: 6 }] };
    let by_const = Pick(a) { fs: TRIPLE };
    pd = by_default;
    pl = by_literal;
    pc = by_const;
}

digital for Bench {
    on at(1n) { a <- 4; }
}
