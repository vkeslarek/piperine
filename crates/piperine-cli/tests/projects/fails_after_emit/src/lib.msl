/// Ideal capacitor.
pub module Capacitor(p: Electrical, n: Electrical) { c: f64 where c > 0.0; }
analog for Capacitor { i(p, n) +> ddt(c * v(p, n)); }

/// A negative resistor: it feeds the node it sits on, so the voltage grows without bound.
pub module NegativeResistor(p: Electrical, n: Electrical) { r: f64 where r > 0.0; }
analog for NegativeResistor { i(p, n) +> -v(p, n) / r; }

/// Writes a record when `a` rises through `level`.
module Monitor(a: Electrical) { level: f64 = 0.5; }
digital for Monitor {
    on cross(v(a) - level) {
        emit!("trip", v = v(a));
    }
}

/// The capacitor starts at 0.1 V and grows as exp(t / 1 us): it crosses 0.5 V at 1.6 us, and
/// by 2 ms the voltage is far beyond what a double holds.
module Top() {
    signal grow: Electrical = 0.1;
    let c1 = Capacitor(grow, gnd) { c: 1n };
    let r1 = NegativeResistor(grow, gnd) { r: 1k };
    let mon = Monitor(grow);
}
