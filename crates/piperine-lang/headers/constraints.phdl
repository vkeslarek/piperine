// dv-core T7 (DVC-09) — the constraint helpers, each carrying its
// pointwise/reduced class and its analysis in a `@quantity` attribute the
// elaborator reads (design §C2: the class is a property of the
// *declaration*, never inferred from a use site — and never folklore in a
// comment). Pointwise helpers exist at every evaluation point and lower to
// per-point margin kernels; reduced helpers exist once per analysis and
// are computed as host-side reductions (D7).

/// The schema of the class marker every helper in this header carries.
extern attribute quantity { class: String, analysis: String }

// ── Pointwise (a value at every evaluation point) ────────────────────────────

/// Magnitude of the probed quantity at the current analysis point.
@quantity(class = "pointwise", analysis = "ac")
extern fn ac_gain(x: Real) -> Real;

/// Phase of the probed quantity at the current analysis point.
@quantity(class = "pointwise", analysis = "ac")
extern fn ac_phase(x: Real) -> Real;

// ── Reduced (one value per completed analysis) ───────────────────────────────

/// The frequency at which the probed quantity's magnitude crosses unity —
/// undefined at any single point, so `reduced` by declaration.
@quantity(class = "reduced", analysis = "ac")
extern fn ac_unity_gain_freq(x: Real) -> Real;

/// The loop's phase margin, reduced over the analysis's sweep.
@quantity(class = "reduced", analysis = "ac")
extern fn ac_phase_margin(x: Real) -> Real;

/// The loop's gain margin, reduced over the analysis's sweep.
@quantity(class = "reduced", analysis = "ac")
extern fn ac_gain_margin(x: Real) -> Real;
