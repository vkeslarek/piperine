// NGSPICE faithful models — uniform distributed RC (URC) lumped line.
//
// Source: ngspice/src/spicelib/devices/urc/  (URC device, lumped RC model).
//
// The ngspice URC device approximates a uniform distributed RC line by a
// finite ladder of N series resistors and N shunt capacitors, one C at every
// tap node including the output. The total line resistance is RPERL·L and
// the total line capacitance is CPERL·L; each lump takes a share whose size
// follows ngspice's geometric taper (the `K` parameter, NGP-16).
//
// Geometric taper (NGP-16). ngspice's `URCsetup` (`urcsetup.c:80-92`) scales
// each segment by `K^i`: segment `i` (0-indexed from the input end) takes a
// `K^i` share of the line total. With `K = 1` the geometric sum collapses to
// `N` and every segment gets an equal `1/N` share (the uniform ladder); with
// `K > 1` the share grows geometrically toward the output. Three authoring
// routes are shipped here:
//
//   1. `urc[N]` is the generic, single-authoring form (NGP-18/NGP-22),
//      using `wire tap : Electrical[N+1]` and a structural `for` loop. The
//      codegen symbol table expands the lifted array wire to N+1 element
//      nodes (NGP-18, Fix A) and the circuit builder unifies them through
//      the structural connections `tap[0] = p; tap[N] = n;` (NGP-18, Fix B),
//      so a circuit instantiating `urc[N]` solves correctly with one MNA
//      unknown per tap. The three golden `urc_lump2/5/10` fixtures
//      instantiate `urc[2]`, `urc[5]`, `urc[10]` respectively — the same
//      hand-built `.cir` ladder topology, unchanged.
//
//   2. `urc_taper_5_k2` is a tapered variant authored as direct `res`/`cap`
//      leaves with the per-segment values computed inline from the
//      normalization `Rtotal · K^i / ΣK^j` (and the C analogue). Its values
//      are baked at module-lowering time, so the taper is real at both DC
//      and AC — the `urc_taper` fixture cross-checks ngspice on it.
//
//   3. `urc_isperl_5_k2` adds the diode-mode shunt path selected by ISPERL
//      (NGP-17), again as direct leaves so the per-segment diode values
//      bake at module-lowering time.
//
// Per-segment R/C are exposed as params so a host can scale them via the
// flat-label override contract (`u1.s[0].r1`, `u1.s[0].c1`, …).
//
// SPEC_DEVIATION: NGP-16 (compile-time taper propagation)
//   The flatten pass bakes each module's per-segment values at module-lowering
//   time using the module's param DEFAULTS, so a per-instance `k` override on
//   `urc[5] { .k = 2.0 }` does not reach the leaves via the param chain. The
//   taper formula is in the model (visible, reviewable); applying it for a
//   specific `k > 1` from a host today uses runtime staging
//   (`Session::builder.stage("u1.s[0].r1", "r", …)`) or a direct-leaf module
//   like `urc_taper_5_k2`. The compile-time propagation gap is a flatten-pass
//   concern, not a URC model concern; it is shared with every nested-leaf
//   param chain in the codebase.
// ════════════════════════════════════════════════════════════════════════════

use piperine::disciplines;
use spice::diode;
use spice::passives;

// ════════════════════════════════════════════════════════════════════════════
//  urc_seg — one ladder lump: a series R (p→n) and a shunt C (n→g).
//
//  Pure-structural: instantiates `res` and `cap` and owns no analog body.
//  This is the recursion base for flattening — a mid-level module whose
//  sub-instances are leaves. When inlined into a parent, its two leaves
//  reappear under path-prefixed labels (`s[0].r1`, `s[0].c1`).
// ════════════════════════════════════════════════════════════════════════════

pub mod urc_seg ( inout p : Electrical, inout n : Electrical, inout g : Electrical ) {
    param r : Real = 100.0;     // series resistance of this lump (Ω)
    param c : Real = 1.0e-9;    // shunt capacitance of this lump (F)

    r1 : res ( .p=p, .n=n ) { .r = r };
    c1 : cap ( .p=n, .n=g ) { .c = c };
}

// ════════════════════════════════════════════════════════════════════════════
//  urc[N] — generic lumped RC line of N `urc_seg` lumps (NGP-18, NGP-22).
//
//  Authored once generically: `wire tap : Electrical[N+1]` with a structural
//  `for` loop instantiating `urc_seg` between successive tap nodes. The
//  const-indexed array net expands during flattening (NGP-20) and codegen
//  lifts it to N+1 element nodes (NGP-18, Fix A) unified through the
//  structural connections `tap[0] = p; tap[N] = n;` (NGP-18, Fix B). A
//  circuit instantiating `urc[N]` solves correctly with one MNA unknown
//  per tap — the same 2N-leaf netlist and DC operating point the
//  previously hand-unrolled triple produced, with no extra authoring.
//
//  Geometric taper (NGP-16). Each segment `i` receives `r·k^i` and `c·k^i`
//  via the per-segment `pow(k, i)` factor. `k = 1.0` (the default) makes
//  `pow` a no-op and the ladder stays uniform — the contract the golden
//  `urc_lump2/5/10` DC fixtures baseline. See the SPEC_DEVIATION note at
//  the top of this file for why a per-instance `k` override needs runtime
//  staging or a direct-leaf module.
// ════════════════════════════════════════════════════════════════════════════

pub mod urc[N] ( inout p : Electrical, inout n : Electrical, inout g : Electrical ) {
    param r : Real = 100.0;
    param c : Real = 1.0e-9;
    param k : Real = 1.0;

    wire tap : Electrical[N + 1];

    tap[0] = p;
    tap[N] = n;

    for i in 0..N {
        s[i] : urc_seg ( .p=tap[i], .n=tap[i + 1], .g=g ) {
            .r = r * pow(k, i),
            .c = c * pow(k, i),
        };
    }
}

// ════════════════════════════════════════════════════════════════════════════
//  urc_taper_5_k2 — five-segment tapered URC ladder (NGP-16, K = 2).
//
//  The taper is ngspice's `K = 2` geometric progression (`urcsetup.c:80-92`)
//  on a *linear* ladder of N series R + N shunt C, normalized to keep
//  total R = 1 kΩ and total C = 10 nF:
//      r_i = Rtotal · K^i / Σ K^j = 1000 · 2^i / 31
//      c_i = Ctotal · K^i / Σ K^j = 1e-8 · 2^i / 31
//  The two ladder topologies differ: ngspice's URC is symmetric (2N R,
//  2N−1 C, half of `Rtotal` on each side); piperine's `urc_taper_5_k2`
//  is linear (N R, N C, all of `Rtotal` on one side). The geometric taper
//  per segment is the same; only the normalization differs. The values are
//  baked at module-lowering time so the taper is real at both DC and AC.
//
//  This module is the piperine twin of `tests/ngspice/urc_taper.cir`, which
//  writes the same per-segment ladder out by hand. The AC cross-check
//  fails when the taper is reverted (a uniform ladder at the same total R/C
//  gives a measurably different transfer function — the test falsifies it).
//
//  Authored as direct `res`/`cap` leaves rather than as a `urc_seg` chain
//  because the flatten pass bakes per-segment values at module-lowering
//  time using param defaults, so a `k` override on a parent `urc[N]`
//  `{ .k = 2.0 }` does not reach the leaves. Direct leaves make the taper
//  observable from the flat netlist without runtime staging.
// ════════════════════════════════════════════════════════════════════════════

pub mod urc_taper_5_k2 ( inout p : Electrical, inout n : Electrical, inout g : Electrical ) {
    wire t1 : Electrical;
    wire t2 : Electrical;
    wire t3 : Electrical;
    wire t4 : Electrical;

    // r_i = 1000 * 2^i / 31 (Ω)  for i = 0..4
    r1 : res ( .p=p,  .n=t1 ) { .r = 1000.0 * pow(2.0, 0.0) / 31.0 };
    r2 : res ( .p=t1, .n=t2 ) { .r = 1000.0 * pow(2.0, 1.0) / 31.0 };
    r3 : res ( .p=t2, .n=t3 ) { .r = 1000.0 * pow(2.0, 2.0) / 31.0 };
    r4 : res ( .p=t3, .n=t4 ) { .r = 1000.0 * pow(2.0, 3.0) / 31.0 };
    r5 : res ( .p=t4, .n=n  ) { .r = 1000.0 * pow(2.0, 4.0) / 31.0 };

    // c_i = 1e-8 * 2^i / 31 (F)  for i = 0..4
    c1 : cap ( .p=t1, .n=g ) { .c = 1.0e-8 * pow(2.0, 0.0) / 31.0 };
    c2 : cap ( .p=t2, .n=g ) { .c = 1.0e-8 * pow(2.0, 1.0) / 31.0 };
    c3 : cap ( .p=t3, .n=g ) { .c = 1.0e-8 * pow(2.0, 2.0) / 31.0 };
    c4 : cap ( .p=t4, .n=g ) { .c = 1.0e-8 * pow(2.0, 3.0) / 31.0 };
    c5 : cap ( .p=n,  .n=g ) { .c = 1.0e-8 * pow(2.0, 4.0) / 31.0 };
}

// ════════════════════════════════════════════════════════════════════════════
//  urc_isperl_5_k2 — five-segment tapered URC ladder with ISPERL diode-mode
//  shunt path (NGP-17, K = 2).
//
//  When ngspice's URC model is given `ISPERL > 0`, the per-segment shunt
//  branch becomes a diode whose `cjo` carries the per-segment capacitance
//  and whose `is` carries the per-segment saturation current
//  (`urcsetup.c:97-113, 179-216`). This module is the linear-ladder analogue:
//  same K = 2 taper as `urc_taper_5_k2`, but each shunt is a `dio` instance
//  whose `DioModel` is the per-segment unit (`cjo = c_unit`, `is = i_unit`)
//  and whose `area = K^i` scales the unit by the geometric factor (mirroring
//  ngspice's per-instance `area = prop`). The diode replaces the capacitor —
//  at DC the shunt conducts (the diode's exponential I-V); at AC it presents
//  both conductance and junction cap.
//
//  Parameters chosen for a measurable but stable DC operating point:
//      c_unit  = 1e-8 / 31   (matches urc_taper_5_k2's per-segment cap)
//      i_unit  = 1e-12 / 31  (per-segment saturation current at area = 1)
//  With `Vsource = 5 V`, `Rload = 1 kΩ` the diodes clamp the tap nodes
//  well below the capacitive case's voltage — a discriminating test that
//  fails if the diode shunt is missing or replaced by a cap.
//
//  Like `urc_taper_5_k2`, authored as direct `res`/`dio` leaves so the
//  taper values bake at module-lowering time and reach the flat netlist
//  without runtime staging. See the SPEC_DEVIATION note at the top of
//  this file for the compile-time propagation gap behind that choice.
// ════════════════════════════════════════════════════════════════════════════

pub mod urc_isperl_5_k2 ( inout p : Electrical, inout n : Electrical, inout g : Electrical ) {
    wire t1 : Electrical;
    wire t2 : Electrical;
    wire t3 : Electrical;
    wire t4 : Electrical;

    // r_i = 1000 * 2^i / 31 (Ω) — same taper as urc_taper_5_k2.
    r1 : res ( .p=p,  .n=t1 ) { .r = 1000.0 * pow(2.0, 0.0) / 31.0 };
    r2 : res ( .p=t1, .n=t2 ) { .r = 1000.0 * pow(2.0, 1.0) / 31.0 };
    r3 : res ( .p=t2, .n=t3 ) { .r = 1000.0 * pow(2.0, 2.0) / 31.0 };
    r4 : res ( .p=t3, .n=t4 ) { .r = 1000.0 * pow(2.0, 3.0) / 31.0 };
    r5 : res ( .p=t4, .n=n  ) { .r = 1000.0 * pow(2.0, 4.0) / 31.0 };

    // d_i : dio with cjo=c_unit, is=i_unit, area=K^i (per-segment scaling).
    // c_unit = 1e-8/31; i_unit = 1e-12/31.
    d1 : dio ( .p=t1, .n=g ) {
        .model = DioModel { .cjo = 1.0e-8 / 31.0, .is = 1.0e-12 / 31.0, .n = 1.0, .rs = 0.0 },
        .area = pow(2.0, 0.0),
    };
    d2 : dio ( .p=t2, .n=g ) {
        .model = DioModel { .cjo = 1.0e-8 / 31.0, .is = 1.0e-12 / 31.0, .n = 1.0, .rs = 0.0 },
        .area = pow(2.0, 1.0),
    };
    d3 : dio ( .p=t3, .n=g ) {
        .model = DioModel { .cjo = 1.0e-8 / 31.0, .is = 1.0e-12 / 31.0, .n = 1.0, .rs = 0.0 },
        .area = pow(2.0, 2.0),
    };
    d4 : dio ( .p=t4, .n=g ) {
        .model = DioModel { .cjo = 1.0e-8 / 31.0, .is = 1.0e-12 / 31.0, .n = 1.0, .rs = 0.0 },
        .area = pow(2.0, 3.0),
    };
    d5 : dio ( .p=n,  .n=g ) {
        .model = DioModel { .cjo = 1.0e-8 / 31.0, .is = 1.0e-12 / 31.0, .n = 1.0, .rs = 0.0 },
        .area = pow(2.0, 4.0),
    };
}
