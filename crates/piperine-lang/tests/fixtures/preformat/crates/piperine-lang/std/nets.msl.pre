//! Resolved nets (§22.3): strengths, `Driven`, `Wire`, `tri`, `sum`, the drivers and pass gates.

/// How hard a drive holds its level. Verilog's drive strengths (IEEE 1364), without charge storage.
#[derive(Repr, PartialEq, PartialOrd)]
pub enum Strength {
    HighZ,
    Weak,
    Pull,
    Strong,
    Supply,
}

#[derive(Repr, PartialEq)]
pub struct Driven {
    pub v: bool,
    pub s: Strength,
}

impl Driven {
    pub const Z: Driven = Driven { v: false, s: Strength::HighZ }; // not driving
    pub fn strong(v: bool) -> Driven {
        Driven { v, s: Strength::Strong }
    }
    pub fn pull(v: bool) -> Driven {
        Driven { v, s: Strength::Pull }
    }
    pub fn weak(v: bool) -> Driven {
        Driven { v, s: Strength::Weak }
    }
    pub fn supply(v: bool) -> Driven {
        Driven { v, s: Strength::Supply }
    }
}

impl Driven {
    /// IEEE 1364 net resolution: the strongest drive wins; equal strengths that disagree are unknown.
    pub fn wired<const N: usize>(d: [Driven; N]) -> Driven {
        d.iter().fold(
            Driven::Z,
            |a, x| if x.s > a.s {
                x
            } else if x.s < a.s {
                a
            } else if a.v == x.v {
                a
            } else {
                Driven { v: false, s: a.s }
            },
        )
    }
}

pub nature Wire {
    value: Driven,
    resolve: Driven::wired,
}

pub fn tri<T: Repr, const N: usize>(d: [Option<T>; N]) -> Option<T> {
    d.iter().fold(
        None,
        |a, x| match (a, x) {
            (None, y) | (y, None) => y,
            _ => None,
        },
    )
}

pub nature Tri<T: Repr> {
    value: Option<T>,
    resolve: tri,
}

pub fn sum<const N: usize>(d: [f64; N]) -> f64 {
    d.iter().sum()
}

pub nature SumNet {
    value: f64,
    resolve: sum,
}

pub module Tribuf(in d: Bit, in oe: Bit, y: Wire) {
    y = if oe {
        Driven::strong(d)
    } else {
        Driven::Z
    };
}

pub module Pullup(w: Wire) {
    w = Driven::pull(true);
}

pub module Pulldown(w: Wire) {
    w = Driven::pull(false);
}

pub module Keeper(w: Wire) {
    signal last: Bit = false;
    w = Driven::weak(last);
}

digital for Keeper {
    on w.changed() && w.s > Strength::Weak {
        last <- w.v;
    }
}

pub module Tran(a: Wire, b: Wire, in en: Bit) {
    a = if en {
        b.others()
    } else {
        Driven::Z
    };
    b = if en {
        a.others()
    } else {
        Driven::Z
    };
}

pub module Tgate(a: Wire, y: Wire, in s: Bit, in sn: Bit) {
    let n = Tran(a, y, s);
    let p = Tran(a, y, !sn);
}
