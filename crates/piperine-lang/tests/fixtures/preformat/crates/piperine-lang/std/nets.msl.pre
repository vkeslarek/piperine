//! Resolved nets (§22.3): strengths, `Drive`, `Wire`, `sum`, the drivers and pass gates.

/// How hard a drive holds its level. Verilog's drive strengths (IEEE 1364), without charge storage.
#[derive(Repr, PartialEq, PartialOrd)]
pub enum Strength {
    HighZ,
    Weak,
    Pull,
    Strong,
    Supply,
}

#[derive(Repr, PartialEq)]
pub struct Drive {
    pub v: bool,
    pub s: Strength,
}

impl Drive {
    pub const Z: Drive = Drive { v: false, s: Strength::HighZ }; // not driving
    pub fn strong(v: bool) -> Drive {
        Drive { v, s: Strength::Strong }
    }
    pub fn pull(v: bool) -> Drive {
        Drive { v, s: Strength::Pull }
    }
    pub fn weak(v: bool) -> Drive {
        Drive { v, s: Strength::Weak }
    }
    pub fn supply(v: bool) -> Drive {
        Drive { v, s: Strength::Supply }
    }
}

impl Drive {
    /// IEEE 1364 net resolution: the strongest drive wins; equal strengths that disagree are unknown.
    pub fn wired<const N: usize>(d: [Drive; N]) -> Drive {
        d.iter().fold(
            Drive::Z,
            |a, x| if x.s > a.s {
                x
            } else if x.s < a.s {
                a
            } else if a.v == x.v {
                a
            } else {
                Drive { v: false, s: a.s }
            },
        )
    }
}

pub nature Wire {
    value: Drive,
}

impl Resolve<Drive> for Wire {
    fn resolve<const N: usize>(d: [Drive; N]) -> Drive {
        Drive::wired(d)
    }
}

pub fn sum<const N: usize>(d: [f64; N]) -> f64 {
    d.iter().sum()
}

pub nature SumNet {
    value: f64,
}

impl Resolve<f64> for SumNet {
    fn resolve<const N: usize>(d: [f64; N]) -> f64 {
        sum(d)
    }
}

pub module Tribuf(in d: Bit, in oe: Bit, y: Wire) {
    y = if oe {
        Drive::strong(d)
    } else {
        Drive::Z
    };
}

pub module Pullup(w: Wire) {
    w = Drive::pull(true);
}

pub module Pulldown(w: Wire) {
    w = Drive::pull(false);
}

pub module Keeper(w: Wire) {
    signal last: Bit = false;
    w = Drive::weak(last);
}

digital for Keeper {
    on w.changed() && w.s > Strength::Weak {
        last <- w.v;
    }
}

pub module Tran(a: Wire, b: Wire, in en: Bit) {
    a = if en {
        b.others()
    } else {
        Drive::Z
    };
    b = if en {
        a.others()
    } else {
        Drive::Z
    };
}

pub module Tgate(a: Wire, y: Wire, in s: Bit, in sn: Bit) {
    let n = Tran(a, y, s);
    let p = Tran(a, y, !sn);
}
