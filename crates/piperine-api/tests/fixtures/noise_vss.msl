// The AC RC twin with its output node named `vss`: an ordinary name, since only `gnd` is the ground (S21).

pub module Resistor(p: Electrical, n: Electrical) {
    r: f64 where r > 0.0;
}
analog for Resistor { i(p, n) +> v(p, n) / r; }

pub module Capacitor(p: Electrical, n: Electrical) {
    c: f64 where c >= 0.0;
}
analog for Capacitor { i(p, n) +> ddt(c * v(p, n)); }

pub module Vsource(p: Electrical, n: Electrical) {
    dc: f64 = 0.0;
    ac: f64 = 0.0;
}
analog for Vsource { v(p, n) +> dc * source_scale() + ac_stim(ac); }

module AcRcVss() {
    signal vin: Electrical;
    signal vss: Electrical;
    let v1 = Vsource { dc: 0.0, ac: 1.0 }(vin, gnd);
    let r1 = Resistor { r: 1000.0 }(vin, vss);
    let c1 = Capacitor { c: 1.5915494309189535e-9 }(vss, gnd);
}
