//! The control path after the ADC (SPEC §6, §7): the setpoint register, the reference ramp and the
//! fixed-point PID. All three run once per sample, on the ADC's `done` strobe.

use crate::spec::*;

/// The 8-bit output-voltage setpoint register (SPEC §7.1), written by the host: `data` is taken
/// on a rising `wr`. A code above 168 saturates to 168 (5.0 V); a write of unknown data is
/// ignored.
pub module SetpointReg(in wr: Bit, in data: Bit<u8>, out code: Bit<u8> = SETPOINT_RESET) {}

digital for SetpointReg {
    on wr.rise() {
        if let Some(d) = data.known() {
            code <- d.min(SETPOINT_MAX);
        }
    }
}

/// The target in ADC codes: 128 + 4 · code, so 0.8 V to 5.0 V in 25 mV steps (SPEC §4.1, §7.1).
pub fn target_codes(setpoint: u8) -> u10 {
    REF_BASE + ((setpoint as u10) << 2)
}

/// The reference ramp (SPEC §7.2): one code per sample towards the target, up or down, which is
/// 3.125 V/ms at the output. It is the soft-start, and it is the slew of every setpoint change.
/// While `run` is low the reference rests at zero.
pub module RefRamp(
    in tick: Bit,
    in run: Bit,
    in target: Bit<u10>,
    out reference: Bit<u10> = 0,
    out at_target: Bit,
) {
    at_target = reference == target;
}

digital for RefRamp {
    on tick.rise() {
        if !run.known_or(false) {
            reference <- 0;
        } else if reference < target {
            reference <- reference + 1;
        } else if reference > target {
            reference <- reference - 1;
        }
    }
}

/// The compensator (SPEC §6.2 to §6.4): a parallel PID with a filtered derivative,
///
/// ```text
/// C(z) = Kp + Ki / (1 − z⁻¹) + Kd · (1 − z⁻¹) / (1 − a · z⁻¹),   Kp = 4, Ki = 0.5, Kd = 64, a = 1/4
/// ```
///
/// in Q4 fixed point (`GAPS.md` G1: integers with the scale in their names). Every gain is an
/// exact integer over 16, the derivative pole is a shift, and the output is a duty word in
/// 1/3200 of the period. The integrator is clamped to the output
/// range and holds while the output is saturated in the direction the error pushes
/// (conditional integration). The sample read at the start of period n sets the duty of period
/// n + 1: the DPWM latches `duty` at its next wrap (SPEC §9).
pub module Pid(
    in tick: Bit,
    in run: Bit,
    in reference: Bit<u10>,
    in meas: Bit<u10>,
    out duty: Bit<u12> = 0,
) {
    /// Integral term, Q4 duty LSBs.
    signal integ: Bit<i32> = 0;
    /// Filtered derivative term, Q4 duty LSBs.
    signal deriv: Bit<i32> = 0;
    /// The error of the previous sample, in codes.
    signal e_prev: Bit<i16> = 0;
}

digital for Pid {
    on tick.rise() {
        if !run.known_or(false) {
            integ <- 0;
            deriv <- 0;
            e_prev <- 0;
            duty <- 0;
        } else {
            // An unknown measurement reads as full scale: the loop then asks for less, never more.
            let e = ((reference.known_or(0) as i16) - (meas.known_or(1023) as i16)).clamp(E_MIN, E_MAX);
            let p = KP_Q4 * (e as i32);
            let d = (deriv >> D_POLE_SHIFT) + KD_Q4 * ((e - e_prev) as i32);
            let u = (p + integ + d) >> Q_SHIFT;
            let u_max = DUTY_MAX as i32;
            let windup = (u > u_max && e > 0) || (u < 0 && e < 0);
            if !windup {
                integ <- (integ + KI_Q4 * (e as i32)).clamp(0, u_max << Q_SHIFT);
            }
            deriv <- d;
            e_prev <- e;
            duty <- u.clamp(0, u_max) as u12;
        }
    }
}
