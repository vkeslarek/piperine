//! The closed-loop start of the buck converter (SPEC §2, §7, §8, §10), as two benches over the
//! package: `Startup` writes the setpoint code 0 (0.8 V) and then raises `en`, with Vin 12 V into
//! the 6.6 ohm load of `Buck`'s defaults; `Idle` never raises `en`, so the supervisor stays `Off`.
use buck::dpwm::Osc;
use buck::top::Buck;
use buck::{Fault, Mode};

/// The host's two writes, on a 1 MHz clock (rising at 0.5 us, 1.5 us, ...): `sp_wr` rises at the
/// first edge with `sp_data` 0 already presented (SPEC §7.1: the register takes it on the
/// rising `wr`), and `en` rises at the second.
module Host(in clk: Bit, out sp_wr: Bit = false, out en: Bit = false) {
    signal n: Bit<u8> = 0;
}
digital for Host {
    on clk.rise() {
        let s = n.known_or(0);
        if s < 2 { n <- s + 1; }
        if s == 0 { sp_wr <- true; }
        if s == 1 { en <- true; }
    }
}

/// The start: 128 samples of soft-start ramp, 64 of power-good delay, then regulation.
module Startup() {
    signal clk: Bit;
    signal en: Bit;
    signal sp_wr: Bit;
    signal sp_data: Bit<u8> = 0;
    signal load_step: Bit = false;
    signal inject: Bit = false;
    signal pgood: Bit;
    signal fault: Bit<Fault>;
    signal mode: Bit<Mode>;
    let osc = Osc(clk) { f: 1M };
    let host = Host(clk, sp_wr, en);
    pub let buck = Buck(en, sp_wr, sp_data, load_step, inject, pgood, fault, mode);
}

/// The converter with `en` held low: no start, the supervisor's mode is `Off` throughout.
module Idle() {
    signal en: Bit = false;
    signal sp_wr: Bit = false;
    signal sp_data: Bit<u8> = 0;
    signal load_step: Bit = false;
    signal inject: Bit = false;
    signal pgood: Bit;
    signal fault: Bit<Fault>;
    signal mode: Bit<Mode>;
    pub let buck = Buck(en, sp_wr, sp_data, load_step, inject, pgood, fault, mode);
}
