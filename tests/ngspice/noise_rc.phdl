// noise_rc — the same thermal-noise-only network as noise_rc.cir. R1 is the
// only noise source; C1 shapes it with a 100 kHz pole and contributes none.
use piperine::disciplines;
use spice::sources;
use spice::passives;
mod Top() {
    wire gnd: Electrical; wire in: Electrical; wire out: Electrical;
    v1: vsrc (.p = in, .n = gnd) { .dc = 0.0, .ac_mag = 1.0 };
    r1: res  (.p = in, .n = out) { .r = 1000.0 };
    c1: cap  (.p = out, .n = gnd) { .c = 1.5915494309189535e-9 };
}
