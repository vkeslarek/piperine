use piperine::disciplines;
use spice::passives;
use spice::sources;

// uic_rc — PHDL twin of uic_rc.cir (NGP-10 part 1). The cap's `ic`
// param seeds the UIC start voltage: `c1 : cap { .ic = 2.0 }` writes
// the same `IC=2.0` line ngspice's `.tran … uic` reads. The
// `@ initial { V(p,n) <- ic; }` block in `headers/spice/passives.phdl`'s
// cap body produces the seed; the default-ic filter in
// `AnalogInstance::initial_conditions` suppresses it for any cap that
// keeps `ic = 0.0` (the model default), so existing transient fixtures
// (e.g. `tran_rc`) that do NOT set `.ic` continue to start from their
// own DC operating point.
//
// The fixture's driver is a step from 0 to 5 V at t=0; with the cap
// pre-charged to 2 V, the response is `v(t) = 5 - 3·exp(-t/RC)` with
// `RC = 1.5915494309189535 µs`. The host runs the transient with
// `uic = true` so the per-instance `ic` seeds (not the DC operating
// point) drive the t=0 state.
mod Top () {
    wire gnd : Electrical;
    wire vin : Electrical;
    wire out : Electrical;
    v1 : vsrc (.p=vin, .n=gnd) { .dc = 5.0 };
    r1 : res  (.p=vin, .n=out) { .r = 1.0e3 };
    c1 : cap  (.p=out, .n=gnd) { .c = 1.5915494309189535e-9, .ic = 2.0 };
}
