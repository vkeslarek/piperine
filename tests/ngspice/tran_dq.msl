//! Twin of `tests/ngspice/tran_dq.cir`: an RC charging curve through a diode whose transit-time
//! charge `tt * id` is nonlinear in the junction voltage. ngspice starts the node at 0 V with
//! `uic`; MSL has no `uic` (§16 H6), so `a` is a held node (§16 H1).
mod devices;
use devices::*;

module TranDq() {
    signal vin: Electrical;
    signal a: Electrical = 0.0;
    let v1 = Vsource { dc: 1.0 }(vin, gnd);
    let r1 = Resistor { r: 1000.0 }(vin, a);
    let c1 = Capacitor { c: 1.5915494309189535e-9 }(a, gnd);
    let d1 = Diode { tt: 1e-6 }(a, gnd);
}
