// noise_mos2_linear — the same triode-biased level-2 NMOS as
// noise_mos2_linear.cir. The channel noise source reads the model's analytic
// gm, which in this region is beta*vds rather than beta*(vgs-vto).
use piperine::disciplines;
use spice::sources;
use spice::passives;
use spice::mos;
mod Top() {
    wire gnd: Electrical; wire vdd: Electrical; wire g: Electrical; wire d: Electrical;
    vd: vsrc (.p=vdd,.n=gnd) { .dc = 5.0 };
    vg: vsrc (.p=g,.n=gnd) { .dc = 3.0 };
    rd: res  (.p=vdd,.n=d) { .r = 6.2e3 };
    m1: mos2 (.d=d,.g=g,.s=gnd,.b=gnd)
        { .l = 1.0e-6, .w = 100.0e-6,
          .model = Mos2Model { .vto = 1.0, .kp = 2.0e-5, .lambda = 0.0, .kf = 0.0 } };
}
