// noise_jfet — the same linear-region JFET as noise_jfet.cir. The channel
// noise source reads the model's analytic gm, which here is betap*vds*(2b+…)
// rather than the saturation form 2*beta*(vgs-vto).
use piperine::disciplines;
use spice::sources;
use spice::passives;
use spice::jfet;
mod Top() {
    wire gnd: Electrical; wire vdd: Electrical; wire g: Electrical; wire d: Electrical;
    vd: vsrc (.p=vdd,.n=gnd) { .dc = 5.0 };
    vg: vsrc (.p=g,.n=gnd) { .dc = 0.0 };
    rd: res  (.p=vdd,.n=d) { .r = 5.0e3 };
    j1: jfet (.d=d,.g=g,.s=gnd)
        { .model = JfetModel { .vto = 0.0 - 2.0, .beta = 1.0e-3, .lambda = 0.0, .kf = 0.0 } };
}
