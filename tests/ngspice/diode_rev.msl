//! Twin of `tests/ngspice/diode_rev.cir`: the harness sweeps `v1.dc` from -1 V to -20 V.
mod devices;
use devices::*;

module DiodeRev() {
    signal vin: Electrical;
    signal a: Electrical;
    let v1 = Vsource { dc: 0.0 }(vin, gnd);
    let r1 = Resistor { r: 1.0 }(vin, a);
    let d1 = Diode { is: 1e-14, n: 1.0 }(a, gnd);
}
