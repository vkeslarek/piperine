// noise_switch — the same closed-switch network as noise_switch.cir.
use piperine::disciplines;
use spice::sources;
use spice::passives;
use spice::switches;
mod Top() {
    wire gnd: Electrical; wire in: Electrical; wire c: Electrical; wire a: Electrical;
    vin: vsrc (.p=in,.n=gnd) { .dc = 1.0, .ac_mag = 1.0 };
    vc:  vsrc (.p=c, .n=gnd) { .dc = 5.0 };
    r1:  res  (.p=in,.n=a) { .r = 1.0e3 };
    s1:  sw   (.p=a,.n=gnd,.cp=c,.cn=gnd)
         { .off = 0, .model = SwModel { .vt = 1.0, .ron = 1.0, .roff = 10.0e3 } };
}
