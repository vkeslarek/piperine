// noise_mos_cox0 — the same tox-less level-1 card as noise_mos_cox0.cir. With
// no tox the model's Cox is 0, and the flicker density substitutes ngspice's
// assumed tox = 1e-7 rather than dividing by zero or dropping the source.
use piperine::disciplines;
use spice::sources;
use spice::passives;
use spice::mos;
mod Top() {
    wire gnd: Electrical; wire vdd: Electrical; wire g: Electrical; wire d: Electrical;
    vd: vsrc (.p=vdd,.n=gnd) { .dc = 5.0 };
    vg: vsrc (.p=g,.n=gnd) { .dc = 3.0 };
    rd: res  (.p=vdd,.n=d) { .r = 6.2e3 };
    m1: mos1 (.d=d,.g=g,.s=gnd,.b=gnd)
        { .l = 1.0e-6, .w = 100.0e-6,
          .model = Mos1Model { .vto = 1.0, .kp = 2.0e-5, .lambda = 0.0,
                               .kf = 1.0e-26, .af = 1.0 } };
}
