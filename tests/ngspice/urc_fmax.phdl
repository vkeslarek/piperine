use piperine::disciplines;
use spice::passives;
use spice::sources;
use spice::urc;

// urc_fmax — PHDL twin of urc_fmax.cir (NGP-19). ngspice's `URCsetup`
// derives the lump count from `FMAX` when `N` is not given
// (`urcsetup.c:84-89`): with `K = 1.5`, `r0 = L·RPERL`, `c0 = L·CPERL`,
// `wnorm = FMAX · r0 · c0 · 2π`. At ngspice's defaults (FMAX = 1e9,
// L = 1, RPERL = 1000, CPERL = 1e-12, K = 1.5) `wnorm ≈ 6.28 < 35`, so
// `N = 3`. The PHDL side lands on the same 3-segment ladder by
// instantiating `urc[URC_DEFAULT_N]` — the constant `urc.phdl` derives
// from the same formula and the same defaults.
//
// The cross-check is the same hand-built discrete R/C ladder as
// `urc_lump{2,5,10}` — three series 100 Ω resistors, three shunt 1 nF
// capacitors, 1 kΩ load. At DC, Vout = 5·1000/(300+1000) = 3.846 V.
mod Top () {
    wire gnd : Electrical;
    wire vin : Electrical;
    wire vout : Electrical;
    v1 : vsrc (.p=vin, .n=gnd) { .dc = 5.0 };
    u1 : urc[URC_DEFAULT_N] (.p=vin, .n=vout, .g=gnd) { .r = 100.0, .c = 1.0e-9 };
    rl : res  (.p=vout, .n=gnd) { .r = 1.0e3 };
}
