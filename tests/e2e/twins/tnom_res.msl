//! Twin of `tests/e2e/twins/tnom_res.cir`: the divider of `temp_res` with the resistor's nominal
//! temperature set to 50 C. The nominal temperature is the model's own parameter `tnom` (analog-operators
//! AO-08, withdrawn as a run key): the resistor is `r * (1 + tc1 * (T - tnom))` at the run's
//! temperature, 27 C by default.
mod devices;
use devices::*;

/// A resistor with a first-order temperature coefficient about its own nominal temperature `tnom` (K).
pub module TcResistor(p: Electrical, n: Electrical) {
    r: f64 where r > 0.0;
    tc1: f64 = 0.0;
    tnom: f64 = 300.15;
}
analog for TcResistor { i(p, n) +> v(p, n) / (r * (1.0 + tc1 * (temperature() - tnom))); }

module TnomRes() {
    signal vin: Electrical;
    signal mid: Electrical;
    let v1 = Vsource { dc: 10.0 }(vin, gnd);
    let r1 = Resistor { r: 1k }(vin, mid);
    let r2 = TcResistor { r: 3k, tc1: 0.002, tnom: 323.15 }(mid, gnd);
}
