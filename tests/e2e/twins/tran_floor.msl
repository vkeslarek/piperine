//! Twin of `tests/e2e/twins/tran_floor.cir`: a node whose current is +1 mA above 0.5 V and -1 mA
//! below it, behind 1 kOhm, from 1 us on: no solution at any step. The run must fail, as ngspice's.
mod devices;
use devices::*;

/// A current of +1 mA when `v(p, n)` is above 0.5 V and -1 mA when it is below, from `from_time` on.
pub module Chatter(p: Electrical, n: Electrical) {
    from_time: f64 = 1e-6;
}
analog for Chatter { i(p, n) +> if now() > from_time { if v(p, n) > 0.5 { 1e-3 } else { -1e-3 } } else { 0.0 }; }

module TranFloor() {
    signal n: Electrical;
    let r1 = Resistor { r: 1000.0 }(n, gnd);
    let b1 = Chatter { from_time: 1e-6 }(n, gnd);
}
