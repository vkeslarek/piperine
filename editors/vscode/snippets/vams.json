{
    "Module": {
        "prefix": "module",
        "body": [
            "module ${1:Name} (inout electrical p, inout electrical n);",
            "    parameter real ${2:r} = 1.0e3;",
            "    analog begin",
            "        $3",
            "    end",
            "endmodule"
        ],
        "description": "Module with electrical ports, a parameter, and an analog body"
    },
    "Analog body": {
        "prefix": "analog",
        "body": [
            "analog begin",
            "    $1",
            "end"
        ],
        "description": "Analog behavior block (LRM §5.7)"
    },
    "Parameter": {
        "prefix": "param",
        "body": [
            "parameter real ${1:name} = ${2:1.0} from (0:inf);"
        ],
        "description": "Real parameter with a from-range (LRM §3.4.2)"
    },
    "Contribution": {
        "prefix": "contrib",
        "body": [
            "${1:I}(p, n) <+ $2;"
        ],
        "description": "Contribution statement (LRM §5.1)"
    },
    "Discipline": {
        "prefix": "discipline",
        "body": [
            "discipline ${1:electrical};",
            "    potential ${2:Voltage};",
            "flow ${3:Current};",
            "enddiscipline"
        ],
        "description": "Discipline declaration (LRM §3.6)"
    },
    "Nature": {
        "prefix": "nature",
        "body": [
            "nature ${1:Voltage};",
            "    units = \"${2:V}\";",
            "    access = ${3:V};",
            "    abstol = ${4:1e-6};",
            "endnature"
        ],
        "description": "Nature declaration (LRM §3.6.1)"
    },
    "Always (digital)": {
        "prefix": "always",
        "body": [
            "always @(posedge ${1:clk}) begin",
            "    $2",
            "end"
        ],
        "description": "Clocked digital process inside a Verilog-AMS module"
    },
    "Constraint block": {
        "prefix": "constraint",
        "body": [
            "constraint begin",
            "    require ${1:name} : ${2:V(p, n) <= 3.3};",
            "end"
        ],
        "description": "Constraint block with a named require (Piperine extension, MD-49)"
    },
    "Include disciplines": {
        "prefix": "inc",
        "body": [
            "`include \"disciplines.vams\""
        ],
        "description": "Include the standard disciplines header"
    }
}
