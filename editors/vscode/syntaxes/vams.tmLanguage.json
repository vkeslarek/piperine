{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Verilog-AMS",
    "scopeName": "source.vams",
    "patterns": [
        { "include": "#comments" },
        { "include": "#directives" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#structure-keywords" },
        { "include": "#control-keywords" },
        { "include": "#net-type-keywords" },
        { "include": "#type-keywords" },
        { "include": "#analog-operators" },
        { "include": "#system-tasks" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.documentation.vams",
                    "match": "///.*$"
                },
                {
                    "name": "comment.line.double-slash.vams",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.vams",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "directives": {
            "name": "keyword.control.directive.vams",
            "match": "`[a-zA-Z_]\\w*"
        },
        "strings": {
            "name": "string.quoted.double.vams",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.vams",
                    "match": "\\\\."
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.vams",
                    "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b"
                },
                {
                    "name": "constant.numeric.scaled.vams",
                    "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?[TGMKkmunpfa]\\b"
                },
                {
                    "name": "constant.numeric.integer.vams",
                    "match": "\\b[0-9][0-9_]*\\b"
                }
            ]
        },
        "structure-keywords": {
            "name": "storage.type.vams",
            "match": "\\b(module|endmodule|macromodule|discipline|enddiscipline|nature|endnature|connectmodule|connectrules|endconnectrules|analog|function|endfunction|task|endtask|paramset|endparamset|primitive|endprimitive|specify|endspecify|table|endtable|noise_table|noise_table_log|config|endconfig|generate|endgenerate|branch|domain)\\b"
        },
        "control-keywords": {
            "name": "keyword.control.vams",
            "match": "\\b(if|else|for|while|repeat|forever|case|casex|casez|default|begin|end|disable|wait|fork|join|event|initial|always|assign|deassign|force|release|posedge|negedge|cross|above|timer|final_step|initial_step)\\b"
        },
        "net-type-keywords": {
            "name": "storage.modifier.vams",
            "match": "\\b(input|output|inout|parameter|localparam|aliasparam|specparam|integer|real|realtime|time|string|genvar|reg|wire|tri|tri0|tri1|triand|trior|trireg|wand|wor|uwire|supply0|supply1|scalared|vectored|signed|unsigned|automatic|ground|potential|flow|access|units|abstol|ddt_nature|idt_nature)\\b"
        },
        "type-keywords": {
            "name": "support.type.vams",
            "match": "\\b(electrical|voltage|current|logic|ddiscrete)\\b"
        },
        "analog-operators": {
            "name": "support.function.vams",
            "match": "\\b(ddt|idt|idtmod|absdelay|absdelta|transition|slew|last_crossing|ac_stim|white_noise|flicker_noise|limexp|laplace_nd|laplace_np|laplace_zd|laplace_zp|zi_nd|zi_np|zi_zd|zi_zp|abs|sqrt|exp|ln|log|min|max|pow|hypot|ceil|floor|sin|cos|tan|asin|acos|atan|atan2|sinh|cosh|tanh|asinh|acosh|atanh)\\b"
        },
        "system-tasks": {
            "name": "support.function.system.vams",
            "match": "\\$[a-zA-Z_]\\w*"
        }
    }
}
